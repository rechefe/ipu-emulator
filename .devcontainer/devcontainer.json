{
  "name": "IPU Emulator Dev Container",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "yardencarmi.ipu-asm",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "BazelBuild.vscode-bazel",
        "maattdd.gitless",
        "pkief.material-icon-theme"
      ]
    }
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "vscode",
  "postCreateCommand": "git config --global core.autocrlf input && bazel version && uv --version"
}
