module(
    name = "ipu_emulator",
    version = "0.1.0",
)

# Rules for Python
bazel_dep(name = "rules_python", version = "0.40.0")
bazel_dep(name = "caseyduquettesc_rules_python_pytest", version = "1.1.1", repo_name = "rules_python_pytest")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.10",
    # Containers such as Claude Code on the web run as root; without this the
    # hermetic interpreter fetch hard-fails instead of emitting a warning.
    ignore_root_user_error = True,
    # Registers coverage.py with the toolchain, so `bazel coverage` (the nightly
    # workflow) measures Python code instead of writing empty reports.
    configure_coverage_tool = True,
)
use_repo(python, "python_3_10")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "ipu_as_deps",
    python_version = "3.10",
    # Committed, hash-pinned lock. Refresh with
    # `bazel run //tools:update_requirements_lock`.
    requirements_lock = "//:requirements_lock.txt",
    # Wheel downloads go through a slow egress proxy in sandboxed CI/agent
    # containers; pip's 15s default read timeout is not enough for numpy.
    # torch is the CPU wheel, from PyTorch's CPU index (the lock pins
    # torch==...+cpu, which PyPI does not have; E06-09). Only the targets that
    # depend on requirement("torch") fetch it.
    extra_pip_args = [
        "--timeout",
        "120",
        "--retries",
        "5",
        "--extra-index-url",
        "https://download.pytorch.org/whl/cpu",
    ],
)
use_repo(pip, "ipu_as_deps")
