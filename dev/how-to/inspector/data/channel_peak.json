{"schemaVersion":1,"kernel":"channel_peak","case":"default","options":{},"source_path":"kernels/detect/channel_peak/channel_peak.asm","source":"{#- ==========================================================================\n    channel_peak.asm -- detector confidence + fixed-threshold gate, FP32 wide\n\n      conf[n] = max over c of logits[c, n]\n      keep[n] = relu(conf[n] - tau)\n\n    SuperPoint's detector read-out with cells in lanes. The per-cell confidence\n    is the maximum over the channel planes; the gate keeps the cells whose\n    confidence clears tau, with a positive shifted score, and zeroes the rest.\n\n    WHY A MAX OVER CHANNELS IS ARGMAX-EQUIVALENT TO THE SOFTMAX PATH:\n      argmax(softmax(x)) == argmax(x), so which cell wins is unchanged by\n      skipping the softmax. The VALUE is not a probability though -- it is the\n      raw logit -- so this replaces the softmax only where the ranking matters.\n\n    NO FAN-OUT, NO AGG:\n      Every cell is an independent maximum and the datapath is 128 lanes wide,\n      so one pass down the channel planes reduces 128 cells at once with\n      ACC.MAX. The running maximum stays a full 128-element vector.\n\n    THE FIRST PLANE IS PEELED:\n      ACC.MAX.FIRST seeds R_ACC from plane 0 without needing a -inf vector, but\n      the channel count is a run-time bound, so the first iteration cannot carry\n      a different accumulate mode. Plane 0 is therefore issued before the loop,\n      and a BGE.S skips the loop entirely when there is only one plane.\n\n    THE THRESHOLD IS A RESIDENT VECTOR:\n      tau is a per-run input vector, not a CR scalar (an FP32 CR scalar would\n      have to hold tau's float32 bit pattern, Q49). It lives\n      in R_CYCLIC slot 1 for the whole run and is subtracted with ACC.SUB. The\n      older kernel negated it and added (AGG max value_cr(-1) then ACC.ADD_AAQ);\n      ACC.SUB does it directly.\n\n      R_ACC is not modified by ACTIVATE.QUANTIZE, so the confidence is stored\n      and then subtracted from in place -- the maximum is computed once.\n\n    ABI (kernel.toml [abi]; CR0/CR1 are READ-ONLY hardware constants):\n      CR0  = 0                        CR1  = 1  (-> 1.0 scalar; every +1)\n      CR2  = INPUT_BASE      (rows)   CR3  = CONFIDENCE_BASE (rows: y[0])\n      CR4  = KEEP_BASE       (rows: y[1])   CR5  = TAU_ROW   (rows)\n      CR6  = TILES -- rows per channel plane, AND the tile-loop bound\n      CR7  = CHANNELS\n      CR10 = 128 (R_CYCLIC slot-1 index, where tau lives)\n      CR15 = dstructure (valid_elements = 128)\n\n    LR uses 3 sub-slots; \";;\" ends a VLIW word, \";\" separates sub-instructions.\n    Slot order within a word is LR -> LOAD -> MULT -> ACC -> AAQ -> STORE ->\n    COND, so ACC.SUB and the ACTIVATE that reads its result share one word,\n    while R_CYCLIC needs a word of separation after its load (its CONTENTS are\n    read from the start-of-word snapshot).\n========================================================================== -#}\n\n{%- set lr_zero = \"LR0\" -%}  {#- 0: mask_shift and the R_CYCLIC slot-0 index -#}\n{%- set lr_t    = \"LR1\" -%}  {#- tile counter AND the tile's row offset -#}\n{%- set lr_c    = \"LR2\" -%}  {#- channel counter -#}\n{%- set lr_addr = \"LR3\" -%}  {#- walking input row address -#}\n{%- set lr_tau  = \"LR4\" -%}  {#- 128: R_CYCLIC slot-1 index, the resident tau -#}\n\n    SET {{lr_zero}} CR0 ;\n    SET {{lr_t}}    CR0 ;\n    SET {{lr_tau}}  CR10 ;;                              {#- 128 -#}\n    LD.MULT.CYCLIC {{lr_zero}} CR5 {{lr_tau}} ;;    {#- slot1 <- tau, resident -#}\n\ntile_loop:\n    ADD {{lr_addr}} {{lr_t}} CR0 ;\n    SET {{lr_c}} CR0 ;;                                  {#- plane 0 of this tile -#}\n    LD.MULT.CYCLIC {{lr_addr}} CR2 {{lr_zero}} ;;   {#- slot0 <- x[0, t] -#}\n    ADD {{lr_addr}} {{lr_addr}} CR6 ;\n    ADD {{lr_c}} {{lr_c}} CR1 ;;\n    MULT.RC.VE {{lr_zero}} CR1 0 {{lr_zero}} CR15 ; ACC.MAX.FIRST ;;\n    BGE.S {{lr_c}} CR7 peak_done ;;                        {#- one plane only: nothing to fold in -#}\n\nchan_loop:\n    LD.MULT.CYCLIC {{lr_addr}} CR2 {{lr_zero}} ;;   {#- slot0 <- x[c, t] -#}\n    ADD {{lr_addr}} {{lr_addr}} CR6 ;\n    ADD {{lr_c}} {{lr_c}} CR1 ;;\n    MULT.RC.VE {{lr_zero}} CR1 0 {{lr_zero}} CR15 ; ACC.MAX ;\n    BLT.S {{lr_c}} CR7 chan_loop ;;                        {#- post-increment: bound CHANNELS -#}\n\npeak_done:\n    ACTIVATE.QUANTIZE identity CR15 ;\n    ST.AAQ {{lr_t}} CR3 ;;                     {#- CONF[t] = max over planes -#}\n    MULT.RC.VE {{lr_tau}} CR1 0 {{lr_zero}} CR15 ; ACC.SUB ;\n    ACTIVATE.QUANTIZE relu CR15 ;\n    ST.AAQ {{lr_t}} CR4 ;;                     {#- KEEP[t] = relu(conf - tau) -#}\n    ADD {{lr_t}} {{lr_t}} CR1 ;;\n    BLT.S {{lr_t}} CR6 tile_loop ;;\n\nend:\n    HALT ;;\n","meta":{"format":"fp32","is_float":true,"element_bits":32,"exp_bits":8,"man_bits":23,"accumulator":"fp32","emulator_only":true,"lut":null},"trace":{"schema_version":"1.0.0","isa_digest":"7e0d11b257cdf1873b81998a87e480eed040716e2e6ebadf4c54a74d12dcb968","program_digest":"e4f140752a10011da0c315ab5ffc8c2124bbfc26d66b30e04c55c06badf97ae3"},"program":[{"label":null,"word":"3000000000000008005206000c000018000008040200000","slots":[{"slot":"lr","instance":0,"op":"SET","args":["LR0","CR0"]},{"slot":"lr","instance":1,"op":"SET","args":["LR1","CR0"]},{"slot":"lr","instance":2,"op":"SET","args":["LR4","CR10"]}]},{"label":null,"word":"3000004000040000400002a08c000018000008040200000","slots":[{"slot":"load","instance":0,"op":"LD.MULT.CYCLIC","args":["LR0","CR5","LR4"]}]},{"label":"tile_loop","word":"3000000881880010400006000c000018000008040200000","slots":[{"slot":"lr","instance":0,"op":"ADD","args":["LR3","LR1","CR0"]},{"slot":"lr","instance":1,"op":"SET","args":["LR2","CR0"]}]},{"label":null,"word":"3000004000040000400002460c000018000008040200000","slots":[{"slot":"load","instance":0,"op":"LD.MULT.CYCLIC","args":["LR3","CR2","LR0"]}]},{"label":null,"word":"30000008b1988891400006000c000018000008040200000","slots":[{"slot":"lr","instance":0,"op":"ADD","args":["LR3","LR3","CR6"]},{"slot":"lr","instance":1,"op":"ADD","args":["LR2","LR2","CR1"]}]},{"label":null,"word":"300000400004000040000600063e000c000008040200000","slots":[{"slot":"mult","instance":0,"op":"MULT.RC.VE","args":["LR0","CR1","0","LR0","CR15"]},{"slot":"acc","instance":0,"op":"ACC.MAX.FIRST","args":[]}]},{"label":null,"word":"18142bc000040000400006000c000018000008040200000","slots":[{"slot":"cond","instance":0,"op":"BGE.S","args":["LR2","CR7","peak_done"]}]},{"label":"chan_loop","word":"3000004000040000400002460c000018000008040200000","slots":[{"slot":"load","instance":0,"op":"LD.MULT.CYCLIC","args":["LR3","CR2","LR0"]}]},{"label":null,"word":"30000008b1988891400006000c000018000008040200000","slots":[{"slot":"lr","instance":0,"op":"ADD","args":["LR3","LR3","CR6"]},{"slot":"lr","instance":1,"op":"ADD","args":["LR2","LR2","CR1"]}]},{"label":null,"word":"100e2bc00004000040000600063e0008000008040200000","slots":[{"slot":"cond","instance":0,"op":"BLT.S","args":["LR2","CR7","chan_loop"]},{"slot":"mult","instance":0,"op":"MULT.RC.VE","args":["LR0","CR1","0","LR0","CR15"]},{"slot":"acc","instance":0,"op":"ACC.MAX","args":[]}]},{"label":"peak_done","word":"3000004000040000400006000c0000180010f18c0200000","slots":[{"slot":"aaq","instance":0,"op":"ACTIVATE.QUANTIZE","args":["IDENTITY","CR15"]},{"slot":"store","instance":0,"op":"ST.AAQ","args":["LR1","CR3"]}]},{"label":null,"word":"300000400004000040000600063e80100011f20c0200000","slots":[{"slot":"mult","instance":0,"op":"MULT.RC.VE","args":["LR4","CR1","0","LR0","CR15"]},{"slot":"acc","instance":0,"op":"ACC.SUB","args":[]},{"slot":"aaq","instance":0,"op":"ACTIVATE.QUANTIZE","args":["RELU","CR15"]},{"slot":"store","instance":0,"op":"ST.AAQ","args":["LR1","CR4"]}]},{"label":null,"word":"30000008888c0000400006000c000018000008040200000","slots":[{"slot":"lr","instance":0,"op":"ADD","args":["LR1","LR1","CR1"]}]},{"label":null,"word":"10041b4000040000400006000c00001800000