{"schemaVersion":1,"kernel":"identity","case":"default","options":{},"source_path":"kernels/reshape/identity/identity.asm","source":"{#- ==========================================================================\n    identity.asm -- the smallest kernel: copies x to y unchanged\n\n    Copies a ROWS x 128 FP32 matrix from CR2 to CR3, one XMEM row at a time.\n\n    CR0 and CR1 are read-only hardware constants; CR1 reads as the scalar\n    1.0, so MULT.VE is an identity operation.\n\n    ABI (kernel.toml [abi]):\n      CR2 = x, the input base row\n      CR3 = y, the output base row\n      CR4 = rows\n      CR15.valid_elements = 128\n\n    XMEM operands are row numbers. One FP32 row is 512 bytes.\n========================================================================== -#}\n\n{%- set lr_zero = \"LR0\" -%}\n{%- set lr_row  = \"LR1\" -%}\n\n    SET {{lr_zero}} CR0 ;\n    SET {{lr_row}} CR0 ;;\n\nrow_loop:\n    LD.MULT R0 {{lr_row}} CR2 ;;\n    MULT.VE {{lr_zero}} CR1 0 {{lr_zero}} CR15 ;\n    ACC.ADD.FIRST ;;\n    ACTIVATE.QUANTIZE identity CR15 ;\n    ST.AAQ {{lr_row}} CR3 ;;\n    ADD {{lr_row}} {{lr_row}} CR1 ;;\n    BLT.S {{lr_row}} CR4 row_loop ;;\n    HALT ;;\n","meta":{"format":"fp32","is_float":true,"element_bits":32,"exp_bits":8,"man_bits":23,"accumulator":"fp32","emulator_only":true,"lut":null},"trace":{"schema_version":"1.0.0","isa_digest":"7e0d11b257cdf1873b81998a87e480eed040716e2e6ebadf4c54a74d12dcb968","program_digest":"65e08a2907637a1897d5b3d41c44df37897a0525d0e9f17b2e9d3f38c7cae448"},"program":[{"label":null,"word":"3000000000000008400006000c000018000008040200000","slots":[{"slot":"lr","instance":0,"op":"SET","args":["LR0","CR0"]},{"slot":"lr","instance":1,"op":"SET","args":["LR1","CR0"]}]},{"label":"row_loop","word":"3000004000040000400000420c000018000008040200000","slots":[{"slot":"load","instance":0,"op":"LD.MULT","args":["R0","LR1","CR2"]}]},{"label":null,"word":"300000400004000040000600103e0004000008040200000","slots":[{"slot":"mult","instance":0,"op"