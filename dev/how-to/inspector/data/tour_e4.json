{"schemaVersion":1,"kernel":"vector_tour","case":"e4","options":{},"source_path":"kernels/conformance/vector_tour/vector_tour.asm","source":"{#- vector_tour.asm -- native vector tour: 128-element INT8 / FP8 vectors (no\n    emulator-only format).\n\n    A curated conformance program for the Cycle Inspector: it walks the MULT\n    and ACC slots once each on real 8-bit data. It loads a mask, two R_CYCLIC\n    slots and R0/R1, runs MULT.VE, MULT.RC.VV/VS/VE and MULT.EE into\n    ACC.ADD/SUB/MAX, two masked multiplies, and a 4-row matrix-vector loop with\n    AGG.SUM.FIRST. kernel.toml's [abi] says which CR holds what.\n\n    Design notes\n    - The registers are written literally (CR2, not a template binding), so the\n      file is plain assembly: the Inspector shows it as source, and its labels\n      are the source's own.\n    - XMEM from row 0: the four rows of a, then w, c and the R_MASK row (three\n      16-byte slots: all lanes, even lanes, the lower half). acc starts at\n      row 8, as the old harness placed it.\n    - acc is three R_ACC stores of four rows each (one accumulator vector is\n      four rows in an 8-bit format): rows 0-3, 4-7 and 8-11 from CR7. In INT8,\n      relu follows at rows 12-15: ACTIVATE.QUANTIZE RELU through ST.AAQ, whose\n      512 bytes hold the 128 results and then zeros. ACTIVATE.QUANTIZE needs\n      INT8, so CR12 (int8_tail) skips that tail in a float format and the\n      results leave through ST.ACC only.\n    - CR9 is the element scalar 2.0 in the active format; CR11 is ROWS - 1\n      because BLT.S reads the counter from the start of the cycle.\n    - The data (gen.py) is small and exact: INT8 elements are integers\n      in [-8, 8], float elements multiples of 0.25 in [-2, 2], which E3, E4\n      and E5 all hold exactly. Every product and sum is then exact in the\n      INT32 or FP32 accumulator, so every format is compared EXACT.\n-#}\n    SET                 LR0 CR0;\n    SET                 LR3 CR6;\n    SET                 LR1 CR0;;\n    LD.MASK             LR0 CR5;\n    SET                 LR4 CR8;;                                 # LR4 = 4: an R0 element used as a scalar below\n    LD.MULT.CYCLIC      LR0 CR3 LR0;;                             # R_CYCLIC[0..127]   = w\n    LD.MULT.CYCLIC      LR0 CR4 LR3;;                             # R_CYCLIC[128..255] = c\n    LD.MULT             R0 LR0 CR2;;                              # R0 = A row 0\n    LD.MULT             R1 LR0 CR3;;                              # R1 = w\n    MULT.VE             LR0 CR9 0 LR0 CR15;  ACC.ADD.FIRST;;      # R_ACC  = 2 * A0\n    MULT.RC.VV          LR0 R0 0 LR0 CR15;   ACC.ADD;;            # R_ACC += w * A0\n    MULT.RC.VS          LR3 0 LR0 CR15;      ACC.SUB;;            # R_ACC -= c * c\n    MULT.RC.VE          LR3 LR4 0 LR0 CR15;  ACC.MAX;;            # R_ACC  = max(R_ACC, c * A0[4])\n    ST.ACC              LR0 CR7;;                                 # output rows 0-3\n    MULT.RC.VV          LR0 R0 1 LR0 CR15;   ACC.ADD.FIRST;;      # mask slot 1: odd lanes off\n    MULT.EE             LR4 CR9 2 LR0 CR15;  ACC.ADD;;            # broadcast 2 * A0[4]; mask slot 2: upper half off\n    ADD                 LR5 LR0 CR8;;\n    ST.ACC              LR5 CR7;;                                 # output rows 4-7\nmatvec:                                                           # R_ACC[r] = A[r] . w\n    LD.MULT             R0 LR1 CR2;;\n    MULT.RC.VV          LR0 R0 0 LR0 CR15;   AGG.SUM.FIRST LR1 CR15;;\n    ADD                 LR1 LR1 CR1;\n    BLT.S               LR1 CR11 matvec;;                         # LR1 before this word's ADD\n    MULT.RC.VV          LR0 R0 0 LR0 CR15;   AGG.MAX.FIRST LR1 CR15;;   # R_ACC[4] = max(A[3] * w)\n    ADD                 LR5 LR5 CR8;;\n    ST.ACC              LR5 CR7;;                                 # output rows 8-11\n    BEQ                 CR12 CR0 end;;\n    ACTIVATE.QUANTIZE   relu CR15;;                               # INT8 only: clamp(relu(R_ACC))\n    ADD                 LR5 LR5 CR8;;\n    ST.AAQ              LR5 CR7;;                                 # output rows 12-15\nend:\n    HALT;;\n","meta":{"format":"e4","is_float":true,"element_bits":8,"exp_bits":4,"man_bits":3,"accumulator":"fp32","emulator_only":false,"lut":[0.0,0.001953125,0.00390625,0.005859375,0.0078125,0.009765625,0.01171875,0.013671875,0.015625,0.017578125,0.01953125,0.021484375,0.0234375,0.025390625,0.02734375,0.029296875,0.03125,0.03515625,0.0390625,0.04296875,0.046875,0.05078125,0.0546875,0.05859375,0.0625,0.0703125,0.078125,0.0859375,0.09375,0.1015625,0.109375,0.1171875,0.125,0.140625,0.15625,0.171875,0.1875,0.203125,0.21875,0.234375,0.25,0.28125,0.3125,0.34375,0.375,0.40625,0.4375,0.46875,0.5,0.5625,0.625,0.6875,0.75,0.8125,0.875,0.9375,1.0,1.125,1.25,1.375,1.5,1.625,1.75,1.875,2.0,2.25,2.5,2.75,3.0,3.25,3.5,3.75,4.0,4.5,5.0,5.5,6.0,6.5,7.0,7.5,8.0,9.0,10.0,11.0,12.0,13.0,14.0,15.0,16.0,18.0,20.0,22.0,24.0,26.0,28.0,30.0,32.0,36.0,40.0,44.0,48.0,52.0,56.0,60.0,64.0,72.0,80.0,88.0,96.0,104.0,112.0,120.0,128.0,144.0,160.0,176.0,192.0,208.0,224.0,240.0,"nan","nan","nan","nan","nan","nan","nan","nan",-0.0,-0.001953125,-0.00390625,-0.005859375,-0.0078125,-0.009765625,-0.01171875,-0.013671875,-0.015625,-0.017578125,-0.01953125,-0.021484375,-0.0234375,-0.025390625,-0.02734375,-0.029296875,-0.03125,-0.03515625,-0.0390625,-0.04296875,-0.046875,-0.05078125,-0.0546875,-0.05859375,-0.0625,-0.0703125,-0.078125,-0.0859375,-0.09375,-0.1015625,-0.109375,-0.1171875,-0.125,-0.140625,-0.15625,-0.171875,-0.1875,-0.203125,-0.21875,-0.234375,-0.25,-0.28125,-0.3125,-0.34375,-0.375,-0.40625,-0.4375,-0.46875,-0.5,-0.5625,-0.625,-0.6875,-0.75,-0.8125,-0.875,-0.9375,-1.0,-1.125,-1.25,-1.375,-1.5,-1.625,-1.75,-1.875,-2.0,-2.25,-2.5,-2.75,-3.0,-3.25,-3.5,-3.75,-4.0,-4.5,-5.0,-5.5,-6.0,-6.5,-7.0,-7.5,-8.0,-9.0,-10.0,-11.0,-12.0,-13.0,-14.0,-15.0,-16.0,-18.0,-20.0,-22.0,-24.0,-26.0,-28.0,-30.0,-32.0,-36.0,-40.0,-44.0,-48.0,-52.0,-56.0,-60.0,-64.0,-72.0,-80.0,-88.0,-96.0,-104.0,-112.0,-120.0,-