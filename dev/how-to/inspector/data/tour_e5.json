{"schemaVersion":1,"kernel":"vector_tour","case":"e5","options":{},"source_path":"kernels/conformance/vector_tour/vector_tour.asm","source":"{#- vector_tour.asm -- native vector tour: 128-element INT8 / FP8 vectors (no\n    emulator-only format).\n\n    A curated conformance program for the Cycle Inspector: it walks the MULT\n    and ACC slots once each on real 8-bit data. It loads a mask, two R_CYCLIC\n    slots and R0/R1, runs MULT.VE, MULT.RC.VV/VS/VE and MULT.EE into\n    ACC.ADD/SUB/MAX, two masked multiplies, and a 4-row matrix-vector loop with\n    AGG.SUM.FIRST. kernel.toml's [abi] says which CR holds what.\n\n    Design notes\n    - The registers are written literally (CR2, not a template binding), so the\n      file is plain assembly: the Inspector shows it as source, and its labels\n      are the source's own.\n    - XMEM from row 0: the four rows of a, then w, c and the R_MASK row (three\n      16-byte slots: all lanes, even lanes, the lower half). acc starts at\n      row 8, as the old harness placed it.\n    - acc is three R_ACC stores of four rows each (one accumulator vector is\n      four rows in an 8-bit format): rows 0-3, 4-7 and 8-11 from CR7. In INT8,\n      relu follows at rows 12-15: ACTIVATE.QUANTIZE RELU through ST.AAQ, whose\n      512 bytes hold the 128 results and then zeros. ACTIVATE.QUANTIZE needs\n      INT8, so CR12 (int8_tail) skips that tail in a float format and the\n      results leave through ST.ACC only.\n    - CR9 is the element scalar 2.0 in the active format; CR11 is ROWS - 1\n      because BLT.S reads the counter from the start of the cycle.\n    - The data (gen.py) is small and exact: INT8 elements are integers\n      in [-8, 8], float elements multiples of 0.25 in [-2, 2], which E3, E4\n      and E5 all hold exactly. Every product and sum is then exact in the\n      INT32 or FP32 accumulator, so every format is compared EXACT.\n-#}\n    SET                 LR0 CR0;\n    SET                 LR3 CR6;\n    SET                 LR1 CR0;;\n    LD.MASK             LR0 CR5;\n    SET                 LR4 CR8;;                                 # LR4 = 4: an R0 element used as a scalar below\n    LD.MULT.CYCLIC      LR0 CR3 LR0;;                             # R_CYCLIC[0..127]   = w\n    LD.MULT.CYCLIC      LR0 CR4 LR3;;                             # R_CYCLIC[128..255] = c\n    LD.MULT             R0 LR0 CR2;;                              # R0 = A row 0\n    LD.MULT             R1 LR0 CR3;;                              # R1 = w\n    MULT.VE             LR0 CR9 0 LR0 CR15;  ACC.ADD.FIRST;;      # R_ACC  = 2 * A0\n    MULT.RC.VV          LR0 R0 0 LR0 CR15;   ACC.ADD;;            # R_ACC += w * A0\n    MULT.RC.VS          LR3 0 LR0 CR15;      ACC.SUB;;            # R_ACC -= c * c\n    MULT.RC.VE          LR3 LR4 0 LR0 CR15;  ACC.MAX;;            # R_ACC  = max(R_ACC, c * A0[4])\n    ST.ACC              LR0 CR7;;                                 # output rows 0-3\n    MULT.RC.VV          LR0 R0 1 LR0 CR15;   ACC.ADD.FIRST;;      # mask slot 1: odd lanes off\n    MULT.EE             LR4 CR9 2 LR0 CR15;  ACC.ADD;;            # broadcast 2 * A0[4]; mask slot 2: upper half off\n    ADD                 LR5 LR0 CR8;;\n    ST.ACC              LR5 CR7;;                                 # output rows 4-7\nmatvec:                                                           # R_ACC[r] = A[r] . w\n    LD.MULT             R0 LR1 CR2;;\n    MULT.RC.VV          LR0 R0 0 LR0 CR15;   AGG.SUM.FIRST LR1 CR15;;\n    ADD                 LR1 LR1 CR1;\n    BLT.S               LR1 CR11 matvec;;                         # LR1 before this word's ADD\n    MULT.RC.VV          LR0 R0 0 LR0 CR15;   AGG.MAX.FIRST LR1 CR15;;   # R_ACC[4] = max(A[3] * w)\n    ADD                 LR5 LR5 CR8;;\n    ST.ACC              LR5 CR7;;                                 # output rows 8-11\n    BEQ                 CR12 CR0 end;;\n    ACTIVATE.QUANTIZE   relu CR15;;                               # INT8 only: clamp(relu(R_ACC))\n    ADD                 LR5 LR5 CR8;;\n    ST.AAQ              LR5 CR7;;                                 # output rows 12-15\nend:\n    HALT;;\n","meta":{"format":"e5","is_float":true,"element_bits":8,"exp_bits":5,"man_bits":2,"accumulator":"fp32","emulator_only":false,"lut":[0.0,1.52587890625e-05,3.0517578125e-05,4.57763671875e-05,6.103515625e-05,7.62939453125e-05,9.1552734375e-05,0.0001068115234375,0.0001220703125,0.000152587890625,0.00018310546875,0.000213623046875,0.000244140625,0.00030517578125,0.0003662109375,0.00042724609375,0.00048828125,0.0006103515625,0.000732421875,0.0008544921875,0.0009765625,0.001220703125,0.00146484375,0.001708984375,0.001953125,0.00244140625,0.0029296875,0.00341796875,0.00390625,0.0048828125,0.005859375,0.0068359375,0.0078125,0.009765625,0.01171875,0.013671875,0.015625,0.01953125,0.0234375,0.02734375,0.03125,0.0390625,0.046875,0.0546875,0.0625,0.078125,0.09375,0.109375,0.125,0.15625,0.1875,0.21875,0.25,0.3125,0.375,0.4375,0.5,0.625,0.75,0.875,1.0,1.25,1.5,1.75,2.0,2.5,3.0,3.5,4.0,5.0,6.0,7.0,8.0,10.0,12.0,14.0,16.0,20.0,24.0,28.0,32.0,40.0,48.0,56.0,64.0,80.0,96.0,112.0,128.0,160.0,192.0,224.0,256.0,320.0,384.0,448.0,512.0,640.0,768.0,896.0,1024.0,1280.0,1536.0,1792.0,2048.0,2560.0,3072.0,3584.0,4096.0,5120.0,6144.0,7168.0,8192.0,10240.0,12288.0,14336.0,16384.0,20480.0,24576.0,28672.0,32768.0,40960.0,49152.0,57344.0,"nan","nan","nan","nan",-0.0,-1.52587890625e-05,-3.0517578125e-05,-4.57763671875e-05,-6.103515625e-05,-7.62939453125e-05,-9.1552734375e-05,-0.0001068115234375,-0.0001220703125,-0.000152587890625,-0.00018310546875,-0.000213623046875,-0.000244140625,-0.00030517578125,-0.0003662109375,-0.00042724609375,-0.00048828125,-0.0006103515625,-0.000732421875,-0.0008544921875,-0.0009765625,-0.001220703125,-0.00146484375,-0.001708984375,-0.001953125,-0.00244140625,-0.0029296875,-0.00341796875,-0.00390625,-0.0048828125,-0.005859375,-0.0068359375,-0.0078125,-0.009765625,-0.01171875,-0.013671875,-0.015625,-0.01953125,-0.0234375,-0.02734375,-0.03125,-0.0390625,-0.