load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("@ipu_as_deps//:requirements.bzl", "requirement")
load("//tools:lint.bzl", "ruff_test")

# All checked-in Markdown and static assets under docs/content/ (MkDocs docs_dir).
filegroup(
    name = "doc_sources",
    srcs = glob([
        "content/**/*.md",
        "content/**/*.svg",
        "content/**/*.csv",
        # The Cycle Inspector page (E08-17): static HTML, CSS and JS, no bundling (D9).
        "content/inspector/*.html",
        "content/inspector/*.css",
        "content/inspector/*.js",
    ]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "generate_mkdocs_md",
    outs = [
        "instructions.md",
        "operand-types.md",
        "assembly-syntax.md",
        "programmer-guide.md",
    ],
    cmd = "$(location //src/tools/ipu-gen:ipu-gen) docs-pages $(RULEDIR) > /dev/null",
    tools = ["//src/tools/ipu-gen:ipu-gen"],
)

# Not stamped: the package's header names a hash of its own content, so its
# bytes, and this action's cache key, depend only on the instruction set.
genrule(
    name = "generate_instruction_format_artifacts",
    outs = ["ipu_instr_pkg.sv"],
    cmd = "$(location //src/tools/ipu-gen:ipu-gen) sv-package --output $(location ipu_instr_pkg.sv) > /dev/null",
    tools = ["//src/tools/ipu-gen:ipu-gen"],
)

# Checks a vendored copy of the package against the hash in its header:
#   bazel run //docs:verify_sv_package -- path/to/ipu_instr_pkg.sv
alias(
    name = "verify_sv_package",
    actual = "//src/tools/ipu-gen:verify_sv_package",
)

genrule(
    name = "generate_instruction_format_md",
    outs = ["instruction-format.md"],
    cmd = "$(location //src/tools/ipu-gen:ipu-gen) instruction-format-md $@ > /dev/null",
    tools = ["//src/tools/ipu-gen:ipu-gen"],
)

# Refreshes the committed docs/content/release-log.md from the GitHub API. Not
# part of any build: the docs build stays offline, and the release-log workflow
# (.github/workflows/release-log.yml) runs this on master after every merge.
#
#   bazel run //docs:update_release_log -- --output "$PWD/docs/content/release-log.md"
py_binary(
    name = "update_release_log",
    srcs = ["update_release_log.py"],
    main = "update_release_log.py",
    python_version = "PY3",
)

# Default tier (not tagged "docs"): runs offline, _get is monkeypatched.
py_pytest_test(
    name = "update_release_log_test",
    srcs = [
        "update_release_log.py",
        "update_release_log_test.py",
    ],
    deps = [requirement("pytest")],
)

# mkdocs's own console script; the plugins are found through their entry points.
py_console_script_binary(
    name = "mkdocs",
    pkg = requirement("mkdocs"),
    script = "mkdocs",
    deps = [
        requirement("mkdocs-material"),
        requirement("mkdocs-git-revision-date-localized-plugin"),
        requirement("mkdocs-redirects"),
    ],
    python_version = "PY3",
)

genrule(
    name = "build_docs",
    srcs = [
        "mkdocs.yml",
        ":doc_sources",
        ":generate_mkdocs_md",
        ":generate_instruction_format_md",
        ":generate_instruction_format_artifacts",
        "//docs/inspector:inspector_data",
        "//:GLOSSARY.md",
        "examples/test_add_an_instruction.py",
        "//src/tools/ipu-isa:test/one_edit.py",
        "hooks/giscus_env.py",
        "hooks/history_link.py",
        "overrides/main.html",
        "overrides/partials/giscus.html",
    ],
    outs = ["site.tar"],
    tags = ["docs", "no-sandbox"],
    cmd = """
        # This genrule is no-sandbox, so the scratch tree survives between builds:
        # wipe it first or deleted pages linger as dangling symlinks and read-only
        # copies of generated artifacts refuse to be overwritten.
        rm -rf $(@D)/docs_temp $(@D)/site_output

        # Temp tree mirrors the repo: mkdocs.yml + hooks/ + overrides/ + content/ (MkDocs docs_dir).
        mkdir -p $(@D)/docs_temp/content
        mkdir -p $(@D)/docs_temp/hooks
        mkdir -p $(@D)/docs_temp/overrides/partials

        # Copy mkdocs config and theme overrides (symlinks would break hook imports)
        cp $(location mkdocs.yml) $(@D)/docs_temp/
        cp $(location hooks/giscus_env.py) $(@D)/docs_temp/hooks/giscus_env.py
        cp $(location hooks/history_link.py) $(@D)/docs_temp/hooks/history_link.py
        cp $(location overrides/main.html) $(@D)/docs_temp/overrides/main.html
        cp $(location overrides/partials/giscus.html) $(@D)/docs_temp/overrides/partials/giscus.html

        # Symlink Markdown sources into content/ so git-based plugins resolve real repo paths.
        ORIGDIR=$$PWD
        for src in $(locations :doc_sources); do
            case "$$src" in
                */docs/content/*) rel="$${src#*/docs/content/}" ;;
                docs/content/*) rel="$${src#docs/content/}" ;;
                *) rel="$$(basename "$$src")" ;;
            esac
            mkdir -p "$$(dirname "$(@D)/docs_temp/content/$$rel")"
            case "$$src" in
                /*) abssrc="$$src" ;;
                *) abssrc="$$ORIGDIR/$$src" ;;
            esac
            ln -sfn "$$abssrc" "$(@D)/docs_temp/content/$$rel"
        done

        # Generated pages (instructions, operand types, assembly syntax, instruction format)
        for out in $(locations :generate_mkdocs_md); do \
          base=$$(basename "$$out"); \
          ln -sfn "$$ORIGDIR/$$out" "$(@D)/docs_temp/content/$$base"; \
        done

        ln -sfn "$$ORIGDIR/$(location :generate_instruction_format_md)" "$(@D)/docs_temp/content/instruction-format.md"

        # reference/glossary.md includes the root GLOSSARY.md through pymdownx.snippets,
        # whose base_path ".." is the parent of the temp tree, as the repo root is of docs/.
        ln -sfn "$$ORIGDIR/$(location //:GLOSSARY.md)" "$(@D)/GLOSSARY.md"

        # how-to/add-an-instruction.md includes tested code the same way, at its repo path.
        mkdir -p "$(@D)/docs/examples" "$(@D)/src/tools/ipu-isa/test"
        ln -sfn "$$ORIGDIR/$(location examples/test_add_an_instruction.py)" "$(@D)/docs/examples/test_add_an_instruction.py"
        ln -sfn "$$ORIGDIR/$(location //src/tools/ipu-isa:test/one_edit.py)" "$(@D)/src/tools/ipu-isa/test/one_edit.py"

        # Generated C header and SystemVerilog package (downloadable; not in git)
        mkdir -p "$(@D)/docs_temp/content/assets"
        for artifact in $(locations :generate_instruction_format_artifacts); do \
          base=$$(basename "$$artifact"); \
          dest="$(@D)/docs_temp/content/assets/$$base"; \
          rm -f "$$dest"; \
          cp "$$ORIGDIR/$$artifact" "$$dest"; \
          chmod u+w "$$dest"; \
        done

        # The Cycle Inspector's data (E08-16): every curated trace, kernels.json
        # and isa.json, regenerated on each build, never checked in.
        mkdir -p "$(@D)/docs_temp/content/inspector/data"
        for data in $(locations //docs/inspector:inspector_data); do \
          dest="$(@D)/docs_temp/content/inspector/data/$$(basename "$$data")"; \
          rm -f "$$dest"; \
          cp "$$ORIGDIR/$$data" "$$dest"; \
          chmod u+w "$$dest"; \
        done

        # Build with mkdocs (execroot must retain .git; use no-sandbox on this genrule).
        cd $(@D)/docs_temp
        $$ORIGDIR/$(location :mkdocs) build --site-dir $$ORIGDIR/$(@D)/site_output
        cd $$ORIGDIR

        # Package output. Sorted names, fixed mtimes and owners: two builds of the
        # same commit give the same site.tar.
        tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
            -cf $@ -C $(@D)/site_output .
    """,
    tools = [":mkdocs"],
)

py_binary(
    name = "serve_docs",
    srcs = ["serve_docs.py"],
    args = ["$(location :build_docs)"],
    data = [":build_docs"],
    main = "serve_docs.py",
    python_version = "PY3",
)

# Doc tests: every `asm` block in the hand-written docs assembles, and every
# documented `ipu-as` command uses only declared options. Default tier.
py_library(
    name = "doc_blocks",
    srcs = [
        "doc_blocks.py",
        "doc_files.py",
    ],
)

py_pytest_test(
    name = "doc_blocks_test",
    size = "small",
    srcs = ["doc_blocks_test.py"],
    deps = [
        ":doc_blocks",
        requirement("pytest"),
    ],
)

_DOC_TEST_DATA = [
    ":doc_sources",
    "//:CLAUDE.md",
    "//:README.md",
    "//:SKILL.md",
]

py_pytest_test(
    name = "test_doc_asm_blocks",
    size = "small",
    srcs = ["test_doc_asm_blocks.py"],
    data = _DOC_TEST_DATA,
    deps = [
        ":doc_blocks",
        "//src/tools/ipu-as-py:ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_doc_commands",
    size = "small",
    srcs = ["test_doc_commands.py"],
    data = _DOC_TEST_DATA,
    deps = [
        ":doc_blocks",
        "//src/tools/ipu-as-py:ipu_as_lib",
        requirement("pytest"),
    ],
)

# The examples How-to: add an instruction includes (examples/), run, and its
# line-range includes of the "one edit" test's entry and handler kept exact.
py_pytest_test(
