# All checked-in Markdown and static assets under docs/content/ (MkDocs docs_dir).
filegroup(
    name = "doc_sources",
    srcs = glob([
        "content/**/*.md",
        "content/**/*.svg",
        "content/**/*.csv",
        # The Cycle Inspector page (E08-17): static HTML, CSS and JS, no bundling (D9).
        "content/inspector/*.html",
        "content/inspector/*.css",
        "content/inspector/*.js",
    ]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "generate_mkdocs_md",
    outs = [
        "instructions.md",
        "operand-types.md",
        "assembly-syntax.md",
        "programmer-guide.md",
        "registers.md",
        "configuration-registers.md",
    ],
    cmd = "$(location //src/tools/ipu-gen:ipu-gen) docs-pages $(RULEDIR) > /dev/null",
    tools = ["//src/tools/ipu-gen:ipu-gen"],
)

# Not stamped: the package's header names a hash of its own content, so its
# bytes, and this action's cache key, depend only on the instruction set.
genrule(
    name = "generate_instruction_format_artifacts",
    outs = ["ipu_instr_pkg.sv"],
    cmd = "$(location //src/tools/ipu-gen:ipu-gen) sv-package --output $(location ipu_instr_pkg.sv) > /dev/null",
    tools = ["//src/tools/ipu-gen:ipu-gen"],
)

# Checks a vendored copy of the package against the hash in its header:
#   bazel run //docs:verify_sv_package -- path/to/ipu_instr_pkg.sv
alias(
    name = "verify_sv_package",
    actual = "//src/tools/ipu-gen:verify_sv_package",
)

# The tables explanation/element-formats.md includes (E09-19).
genrule(
    name = "generate_element_format_tables",
    outs = ["element-format-tables.md"],
    cmd = "$(location //src/tools/ipu-gen:ipu-gen) element-format-tables $@ > /dev/null",
    tools = ["//src/tools/ipu-gen:ipu-gen"],
)

# The timing model page (content/explanation/timing-model.md) includes this table
