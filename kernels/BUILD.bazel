# The kernel tree (ADR 0006, E06): one Bazel package per kernel,
# //kernels/<family>/<name>, declared with ipu_kernel() from kernels/defs.bzl.
# Kernels move here from src/tools/ipu-apps during E06 and E07.

load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:lint.bzl", "ruff_test")
load(":defs.bzl", "ipu_kernel_tree")

exports_files([
    "BUILD.bazel",
    "families.bzl",
])

# :tree: every family's and kernel's files, for ipu_harness.registry.kernel_tree()
# (the routing registry, E06-16); :all_kernels: the tree with every family's
# library; :kernel_targets; :lint. The families and their kernels are in
# families.bzl (KERNELS, FAMILY_DEPS).
ipu_kernel_tree()

# Cross-family use is declared in FAMILY_DEPS only (E06-18); KERNELS names
# every kernel folder. It reads the checkout's kernels/ (a folder missing from
# KERNELS is no input of the test), so it is not cached.
py_pytest_test(
    name = "test_families",
    size = "small",
    srcs = ["test_families.py"],
    data = [
        "families.bzl",
        "//src/tools/ipu-kernels:py_sources",
        ":tree",
    ],
    tags = ["external"],
    deps = [requirement("pytest")],
)

ruff_test(
    name = "ruff",
    srcs = glob(["*.py"]),
)

# Which kernel computes an op, and why (E06-16):
#   bazel run //kernels:query -- scale rows=7
alias(
    name = "query",
    actual = "//src/tools/ipu-harness:query",
    visibility = ["//visibility:public"],
)

# Every kernel, its cases and targets, as JSON for tools (E06-13): the same keys
# as //src/tools/ipu-apps:kernel_manifest.
#   bazel run //kernels:manifest
py_binary(
    name = "manifest",
    srcs = ["//src/tools/ipu-harness:src/ipu_harness/manifest_json.py"],
    main = "//src/tools/ipu-harness:src/ipu_harness/manifest_json.py",
    args = ["$(rootpath :kernel_targets)"],
    data = [":kernel_targets"],
    deps = [
        ":all_kernels",
        "//src/tools/ipu-harness:ipu_harness_lib",
    ],
)
