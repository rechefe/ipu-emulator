# The attention family (E07-12, E07-13): one folder kernel per stage and
# MobileViT layer. The score kernels (qk_scores_*, query-major; and
# attn_scores_km_*, key-major) are separate ops, so the registry never hands
# one chain's scores to the other chain's consumer. gen.py, beside the
# kernels, is their shared case generator (data, loaded by path). The family
# tests use the softmax family's kernels (FAMILY_DEPS), so :tests routes
# through the whole tree.

load("//kernels:defs.bzl", "ipu_kernel_family")

ipu_kernel_family(
    tests_size = "large",
    tests_tree = True,
)
