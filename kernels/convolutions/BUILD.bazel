# The convolutions (E07-16 onwards): kernel folders, the registry.toml entries
# over the conv_universal_tpl template (//kernels/convolutions:<entry>, E07-17),
# and beside them their shared pack transforms (pack.py) and mask bytes
# (masks.py), loaded by path. The family's Python package,
# ipu_kernels.convolutions, holds the Conv2d layer adapter. test_*.py
# (routing, the layer adapter) run as :tests, over the whole kernel tree: they
# resolve conv2d queries through the registry and the query tool.

load("//kernels:defs.bzl", "ipu_kernel_family")
load(":registry.bzl", "ENTRIES")

ipu_kernel_family(
    entries = ENTRIES,
    tests_tree = True,
)
