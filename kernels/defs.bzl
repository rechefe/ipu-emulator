"""ipu_kernel: the Bazel macro that declares one kernel (E06-13).

    load("//kernels:defs.bzl", "ipu_kernel")

    ipu_kernel()

in kernels/<family>/<name>/BUILD.bazel, a folder that holds <name>.asm,
kernel.toml and the files they name (reference.py, data/, test_*.py). It
declares:

* :<name>: `bazel test` runs every default-tier case in every format it runs in
  (`test_case[<case>-<format>]`) and the folder's test_*.py; `bazel run` runs
  one case through the CLI (`-- --case NAME --format FMT ...`).
* :<name>_nightly: the cases with `tier = "nightly"` (Q73): size enormous,
  so the default tier skips it and `--config=full` (the nightly run) runs it.
* :assemble_<name>: <name>.bin, the default case's program in its first format.
* :<name>_files: the folder's files, which //kernels:tree joins.

A family's shape variants are entries of kernels/<family>/registry.toml over a
template folder (an ordinary ipu_kernel() folder, E06-17):

    load("//kernels:defs.bzl", "ipu_kernel_family")
    load(":registry.bzl", "ENTRIES")

    ipu_kernel_family(ENTRIES)

in kernels/<family>/BUILD.bazel declares :<entry>, :<entry>_nightly and
:assemble_<entry> for each entry, as ipu_kernel() does for a folder, plus
:registry_files (for //kernels:tree) and :registry_bzl_test, which fails when
registry.bzl (generated by `bazel run //kernels:update_registry_bzl`) is stale.
"""

load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")

_ENTRY = "//src/tools/ipu-harness:src/ipu_harness/kernel_test.py"
_PYTEST_SHIM = "@rules_python_pytest//python_pytest:pytest_shim.py"
_REGISTRY_BZL = "//src/tools/ipu-harness:src/ipu_harness/registry_bzl.py"
_KERNEL_BIN = "//src/tools/ipu-harness:kernel_bin"

_DEPS = [
    "//src/tools/ipu-harness:ipu_harness_lib",
    "//src/tools/ipu-harness:kernel_test_lib",
    "//src/tools/ipu-kernels:ipu_kernels_lib",
    requirement("pytest"),
    requirement("torch"),
]

def _kernel_targets(name, kernel, data, deps, size, shard_count):
    """:<name> (the default tier), :<name>_nightly and :assemble_<name>.

    `kernel` names the kernel by its files' `$(rootpath)`: kernel.toml, or
    `<registry.toml>::<entry>`. :assemble_<name> writes <name>.bin, the default
    case's program in its first format (ipu_harness.kernel_bin).
    """
    native.genrule(
        name = "assemble_" + name,
        srcs = data,
        outs = [name + ".bin"],
        tools = [_KERNEL_BIN],
        cmd = "$(execpath %s) %s $@" % (_KERNEL_BIN, kernel.replace("$(rootpath ", "$(execpath ")),
    )
    for target, tier, target_size, tags in [
        (name, "default", size, []),
        (name + "_nightly", "nightly", "enormous", ["nightly"]),
    ]:
        py_test(
            name = target,
            srcs = [_ENTRY, _PYTEST_SHIM],
            main = _ENTRY,
            args = [kernel, "$(location " + _PYTEST_SHIM + ")", tier],
            data = data,
            deps = deps,
            legacy_create_init = False,
            size = target_size,
            shard_count = shard_count,
            tags = tags,
        )

def ipu_kernel(name = None, extra_deps = [], size = "large", shard_count = None):
    """Declare kernel `name` from its folder.

    Args:
        name: the kernel's name; default the folder's (the last path component).
        extra_deps: libraries the folder's test_*.py import.
        size: the test size of :<name> (kernels run in the emulator).
        shard_count: shards of :<name> and :<name>_nightly; set it for a kernel
            with more than about 60 case x format runs, so a shard keeps inside
            the CI budget (Starlark cannot read kernel.toml to count them).
    """
    name = name or native.package_name().rpartition("/")[2]
    files = native.glob(
        ["**"],
        exclude = ["BUILD.bazel", "BUILD", "**/__pycache__/**", "**/*.pyc"],
    )
    native.filegroup(
        name = name + "_files",
        srcs = files,
        visibility = ["//visibility:public"],
    )
    _kernel_targets(name, "$(rootpath kernel.toml)", files, _DEPS + extra_deps, size, shard_count)

def ipu_kernel_family(entries, size = "large", shard_count = {}):
    """Declare the entries of this family's registry.toml.

    Args:
        entries: ENTRIES from the family's registry.bzl ({"name", "template"} each).
        size: the test size of each :<entry>.
        shard_count: shards by entry name, for an entry with many case x format runs.
    """
    package = native.package_name()
    native.filegroup(
        name = "registry_files",
        srcs = ["registry.toml", "registry.bzl"],
        visibility = ["//visibility:public"],
    )
    py_test(
        name = "registry_bzl_test",
        srcs = [_REGISTRY_BZL],
        main = _REGISTRY_BZL,
        args = ["check", "$(rootpath registry.toml)", "$(rootpath registry.bzl)"],
        data = ["registry.toml", "registry.bzl"] + [
            "//%s/%s:%s_files" % (package, t, t)
            for t in sorted({e["template"]: None for e in entries}.keys())
        ],
        deps = ["//src/tools/ipu-harness:ipu_harness_lib"],
        legacy_create_init = False,
        size = "small",
    )
    for entry in entries:
        name, template = entry["name"], entry["template"]
        _kernel_targets(
            name,
            "$(rootpath registry.toml)::" + name,
            ["registry.toml", "//%s/%s:%s_files" % (package, template, template)],
            _DEPS,
            size,
            shard_count.get(name),
        )

def _label(kernel, target):
    return "//kernels/" + kernel + ":" + target

def _add(targets, name, target):
    if name in targets:
        fail("ipu_kernel_tree: two kernels are named %s (%s and %s)" % (name, targets[name]["dir"], target["dir"]))
    targets[name] = target

def ipu_kernel_tree(kernels, registries = {}):
    """Declare //kernels' :tree (every kernel's files) and :kernel_targets (its targets, JSON).

    Bazel cannot glob into subpackages, so `kernels` names each kernel folder
    ("<family>/<name>", templates included) and `registries` each family's
    registry.toml entries; //src/tools/ipu-harness:test_kernel_tree checks they
    name every folder that holds a kernel.toml and every registry.toml.

    Args:
        kernels: every kernel folder under kernels/, as "<family>/<name>".
        registries: ENTRIES of each family's registry.bzl, by family name.
    """
    native.filegroup(
        name = "tree",
        srcs = ["BUILD.bazel"] + [_label(k, k.rpartition("/")[2] + "_files") for k in kernels] +
               ["//kernels/%s:registry_files" % family for family in registries],
        visibility = ["//visibility:public"],
    )
    targets = {}
    families = {}
    for kernel in kernels:
        name = kernel.rpartition("/")[2]
        label = _label(kernel, name)
        families.setdefault(kernel.rpartition("/")[0], []).append(label)
        _add(targets, name, {
            "dir": "kernels/" + kernel,
            "family": kernel.rpartition("/")[0],
            "run": label,
            "test": label,
            "nightly": label + "_nightly",
        })
    for family, entries in registries.items():
        for entry in entries:
            label = "//kernels/%s:%s" % (family, entry["name"])
            families.setdefault(family, []).append(label)
            _add(targets, entry["name"], {
                "dir": "kernels/%s/%s" % (family, entry["template"]),
                "family": family,
                "registry": "kernels/%s/registry.toml" % family,
                "template": entry["template"],
                "run": label,
                "test": label,
                "nightly": label + "_nightly",
            })
    # :<family>: every kernel of the family (the manifest's family suite).
    for family, labels in families.items():
        native.test_suite(name = family, tests = labels, visibility = ["//visibility:public"])
    content = json.encode_indent(
        {
            "kernels": targets,
            "families": {family: {"suite": "//kernels:" + family} for family in families},
            "query": "//kernels:query",
        },
        indent = "  ",
    )
    native.genrule(
        name = "kernel_targets",
        outs = ["kernel_targets.json"],
        visibility = ["//visibility:public"],
        cmd = "cat > $@ <<'IPU_KERNEL_TARGETS'\n" + content + "\nIPU_KERNEL_TARGETS\n",
    )
