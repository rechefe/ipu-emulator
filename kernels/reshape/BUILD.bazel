# The reshape family (E07-04, E07-05): folder kernels, and the registry.toml
# entries over the concat template (//kernels/reshape:<entry>, as the
# old targets were named).

load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//kernels:defs.bzl", "ipu_kernel_family")
load(":registry.bzl", "ENTRIES")

ipu_kernel_family(entries = ENTRIES)

# Routing: each concat entry is found by exactly its (h, w, c_a, c_b), and the
# folder kernels by their parameters, as the old router found them.
py_pytest_test(
    name = "test_routing",
    size = "small",
    srcs = ["test_routing.py"],
    data = ["//kernels:tree"],
    deps = [
        "//src/ipu-harness:ipu_harness_lib",
        requirement("pytest"),
    ],
)

# fold(unfold(x)) == x on one model (ipu_harness.chain), plain and with R_ACC
# poisoned before fold: the old family test.py.
py_pytest_test(
    name = "test_fold_unfold",
    size = "medium",
    srcs = ["test_fold_unfold.py"],
    data = ["//kernels:tree"],
    deps = [
        "//src/ipu-harness:ipu_harness_lib",
        "//src/ipu-isa:ipu_isa_lib",
        requirement("numpy"),
        requirement("pytest"),
    ],
)
