# The Q71 emulator benchmarks (E04-02): IpuState() construction, matmul cycles/s
# (FP32, INT8 and E4; prototyping too with --config=proto). A `bazel run`
# target, not a test: //tools/bench:test_bench_smoke keeps it from rotting.
# tools/bench/README.md.
# E04-02 names this label; the code lives in //tools/bench as its `emulator`
# module, so the nightly runner tracks it too.
py_binary(
    name = "bench_emulator",
    srcs = ["bench/bench_emulator.py"],
    main = "bench/bench_emulator.py",
    deps = ["//tools/bench:ipu_bench"],
)

# Ruff lint and format over this package's Python files (tools/lint.bzl).
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
)

# The stable reference-model API (E04-30), type-checked strictly on its own
# (Q65): the library holds only its module; the rest of ipu_emu, not yet
# strict-clean, is on the path as data so imports resolve. For mypy only:
# its deps are incomplete, so users depend on ipu_emu_lib, which also holds
# the module.
py_library(
    name = "reference_lib",
    srcs = ["src/ipu_emu/reference.py"],
    imports = ["src"],
    visibility = ["//visibility:private"],
    deps = ["//src/ipu-isa:ipu_isa_lib"] + [requirement(dep) for dep in RUNTIME_DEPS],
)

mypy_test(
    name = "mypy_reference",
    data = [":ipu_emu_lib"],
    lib = ":reference_lib",
    strict = True,
)

