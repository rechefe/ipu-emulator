    name = "conformance_support",
    testonly = True,
    srcs = ["test/conformance.py"],
    imports = ["test"],
    deps = [
        ":ipu_emu_lib",
        "//src/ipu-isa:ipu_isa_lib",
    ],
)

py_library(
    name = "conformance_cases",
    testonly = True,
    srcs = ["test/conformance_cases.py"],
    imports = ["test"],
    deps = [
        ":conformance_support",
        ":ipu_emu_lib",
        ":timing_probes",
        "//src/ipu-as:ipu_as_lib",
        "//src/ipu-isa:ipu_isa_lib",
    ],
)

py_binary(
    name = "update_conformance",
    testonly = True,
    srcs = ["test/regen_conformance.py"],
    main = "test/regen_conformance.py",
    deps = [
        ":conformance_cases",
        ":conformance_support",
        ":ipu_emu_lib",
    ],
)

alias(
    name = "regen_conformance",
    actual = ":update_conformance",
)

