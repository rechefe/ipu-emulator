{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rechefe/ipu-emulator/schemas/inspector-trace/2",
  "title": "Cycle Inspector trace",
  "description": "One recorded kernel case as the Cycle Inspector page reads it (E08-16): a presentation of an E04-29 trace, written by ipu_gen.inspector_trace. Hex strings are lowercase; vector data is little-endian.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "kernel", "case", "options", "source_path", "source", "meta", "trace",
    "program", "layout", "init", "cycles", "total_cycles", "truncated"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "kernel": {"type": "string"},
    "case": {"type": "string"},
    "options": {"type": "object"},
    "source_path": {"type": "string"},
    "source": {"type": "string"},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "variant", "element_bits", "accumulator", "emulator_only", "nx8", "lut"],
      "properties": {
        "format": {"enum": ["nx8", "fp32"], "description": "The run mode (ADR 0007)."},
        "variant": {"type": "string", "description": "The case's variant, as kernel.toml's formats name it."},
        "element_bits": {"type": "integer"},
        "accumulator": {"type": "string"},
        "emulator_only": {"type": "boolean", "description": "An emulator-only mode (FP32)."},
        "nx8": {
          "description": "The NX8 element type, a QF half's fields; null in FP32.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sign", "exp_format", "num_bits", "dynamic"],
              "properties": {
                "sign": {"enum": [0, 1]},
                "exp_format": {"type": "integer", "minimum": 0, "maximum": 7},
                "num_bits": {"type": "integer", "minimum": 1, "maximum": 8},
                "dynamic": {"type": "boolean"}
              }
            }
          ]
        },
        "lut": {
          "description": "NX8: per dynamic_exponent (one table, two for a dynamic type), each code's value at unit scale (scale 127). An element is its code's entry times 2^(scale - 127), from its row's metadata word. Null in FP32.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {"type": "array", "minItems": 256, "maxItems": 256, "items": {"type": "number"}}
            }
          ]
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "isa_digest", "program_digest"],
      "properties": {
        "schema_version": {"type": "string"},
        "isa_digest": {"type": "string"},
        "program_digest": {"type": "string"}
      }
    },
    "program": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "word", "slots"],
        "properties": {
          "label": {"type": ["string", "null"]},
          "word": {"$ref": "#/$defs/hex_number"},
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot", "instance", "op", "args"],
              "properties": {
                "slot": {"type": "string"},
                "instance": {"type": "integer", "minimum": 0},
                "op": {"type": "string"},
                "args": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "array",
      "description": "Every field of the word, MSB to LSB: [name, width, slot].",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "integer", "minimum": 1}, {"type": "string"}],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "init": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/hex_bytes"}
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pc", "d", "m"],
        "properties": {
          "pc": {"type": "integer", "minimum": 0},
          "d": {
            "type": "object",
            "description": "Register writes: lr and cr as {index: value}, any other register as [[byte offset, hex], ...].",
            "additionalProperties": {
              "oneOf": [
                {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
                {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [{"type": "integer", "minimum": 0}, {"$ref": "#/$defs/hex_bytes"}],
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              ]
            }
          },
          "m": {
            "type": "array",
            "description": "XMEM accesses: [R or W, address, bytes].",
            "items": {
              "type": "array",
              "prefixItems": [
                {"enum": ["R", "W"]},
                {"type": "integer", "minimum": 0},
                {"type": "integer", "minimum": 1}
              ],
              "minItems": 3,
              "maxItems": 3
            }
          },
          "M": {
            "type": "array",
            "minItems": 1,
            "description": "XMEM metadata words written: [address of the 128-byte unit, value] (scale[7:0], dynamic_exponent[8]).",
            "items": {
              "type": "array",
              "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0, "maximum": 65535}],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "L": {"type": "integer", "minimum": 1, "description": "Multiplier lanes used."},
          "o": {"enum": ["break", "halt", "fault"], "description": "The outcome, when not retired."}
        }
      }
    },
    "total_cycles": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"}
  },
  "$defs": {
    "hex_bytes": {"type": "string", "pattern": "^([0-9a-f]{2})*$"},
    "hex_number": {"type": "string", "pattern": "^[0-9a-f]+$"}
  }
}
