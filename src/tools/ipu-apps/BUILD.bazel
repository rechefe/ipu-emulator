load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@ipu_apps_pyproject//:deps.bzl", "get_requirements")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//:ipu_app.bzl", "ipu_app")
load("//:asm_rules.bzl", "assemble_asm")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
])

py_library(
    name = "ipu_apps_lib",
    srcs = glob(["src/ipu_apps/**/*.py"]),
    imports = ["src"],
    deps = [
        "//src/tools/ipu-emu-py:ipu_emu_lib",
        "//src/tools/ipu-as-py:ipu_as_lib",
        "//src/tools/ipu-common:ipu_common_lib",
    ] + get_requirements(requirement),
)

# Each declaration uses the same registry frontend and the adjacent test.py.
ipu_app(
    name = "fully_connected",
    kernel_package = "src/ipu_apps/fully_connected",
    data = glob(["src/ipu_apps/fully_connected/test_data_format/**/*.bin"]),
    deps = [":ipu_apps_lib"],
    test_deps = [requirement("pytest")],
)

[
    ipu_app(
        name = name,
        kernel_package = "src/ipu_apps/softmax/" + name,
        deps = [":ipu_apps_lib"],
        test_deps = [requirement("pytest")],
    )
    for name in [
        "softmax_rows", "softmax_rows_partial", "softmax_rows_long",
        "softmax_columns", "softmax_columns_packed",
    ]
]

ipu_app(
    name = "identity",
    kernel_package = "src/ipu_apps/kernel_registry/identity",
    deps = [":ipu_apps_lib"],
    test_deps = [requirement("pytest")],
)

py_pytest_test(
    name = "test_harness_factory",
    srcs = ["test/test_harness_factory.py"],
    data = ["pyproject.toml"] + glob(["src/ipu_apps/**/*.asm", "src/ipu_apps/fully_connected/test_data_format/**/*.bin"]),
    deps = [":ipu_apps_lib", requirement("pytest")],
)

# Runs every softmax app, so it needs all five .asm files.
py_pytest_test(
    name = "test_softmax_layout_roundtrip",
    srcs = ["test/test_softmax_layout_roundtrip.py"],
    data = [
        "src/ipu_apps/softmax/softmax_columns/softmax_columns.asm",
        "src/ipu_apps/softmax/softmax_columns_packed/softmax_columns_packed.asm",
        "src/ipu_apps/softmax/softmax_rows/softmax_rows.asm",
        "src/ipu_apps/softmax/softmax_rows_long/softmax_rows_long.asm",
        "src/ipu_apps/softmax/softmax_rows_partial/softmax_rows_partial.asm",
    ],
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

# Router only -- no .asm needed; it constructs apps but never runs them.
py_pytest_test(
    name = "test_softmax_registry",
    srcs = ["test/test_softmax_registry.py"],
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

# Kernel registry mechanics + the generic conformance suite, which assembles
# and runs whichever kernel the registry resolves -- so every registered .asm
# is data here, and a newly added kernel is covered without editing this rule.
py_pytest_test(
    name = "test_kernel_registry",
    srcs = ["test/test_kernel_registry.py"],
    data = glob(["src/ipu_apps/**/*.asm"]),
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

# Checks the routing tables printed in the docs against what the registry
# actually answers. The tables are checked-in text, so without this they are a
# second copy of the routing rules -- the copy that goes stale.
py_pytest_test(
    name = "test_docs_routing",
    srcs = ["test/test_docs_routing.py"],
    data = ["//docs:doc_sources"],
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

# Retained for consumers that need the assembled artifact directly.
assemble_asm(
    name = "assemble_fully_connected",
    src = "src/ipu_apps/fully_connected/fully_connected.asm",
)

py_pytest_test(
    name = "test_debug_launch",
    srcs = ["test/test_debug_launch.py"],
    data = ["src/ipu_apps/kernel_registry/identity/identity.asm"],
    deps = [":ipu_apps_lib", requirement("pytest")],
)
