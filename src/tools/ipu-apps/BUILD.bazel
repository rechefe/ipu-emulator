# -- mutation-based re-check: weight-row-pointer bug class across all 8 --
# -- L4/L5 proj_*_p4 kernels (see kernel_docs/kernel_layer_map.md) --

py_pytest_test(
    name = "test_proj_p4_weight_pointer_mutation_check",
