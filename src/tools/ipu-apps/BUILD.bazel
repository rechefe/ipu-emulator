# -- full transformer layer, end to end (L4: d=192, N_TOK=64, L=4 layers) --
# LayerNorm -> QKV proj -> repack -> scores -> softmax stub -> attn@V ->
# head concat -> out_proj -> residual -> LayerNorm -> FFN1 -> silu -> FFN2 ->
# residual, both attention mappings (query-major, key-major), run separately.
#
# Every target below that chains 2+ kernels through part or all of a layer
# is `manual`: the full 4-layer stack measured 2h14m for a single mapping in
# this environment, and per_stage_error still runs the whole single-layer
# chain. Automatic per-push CI coverage for these kernels comes from each
# app's own standalone test (`test_<app>_wide.py`) plus the pairwise `seam`
# tests; run these explicitly when validating a cross-kernel change, e.g.:
#   bazel test //src/tools/ipu-apps:test_full_layer_l4_query_major
# The one exception is scale_visibility, which builds no kernels at all
# (pure numpy arithmetic) and stays automatic as a free sanity check.

_L4_FULL_LAYER_SRCS = [
    "test/test_full_layer_l4.py",
    "test/fixture_full_layer_chain.py",
    "test/fixture_host_softmax_fold_stubs.py",
]

# USE_REAL_SOFTMAX=1 routes softmax through softmax_rows_partial /
# softmax_columns_packed instead of the numpy stub -- see USE_REAL_SOFTMAX in
# test_full_layer_l4.py and real_softmax_query_major/real_softmax_key_major
# in fixture_full_layer_chain.py. Real kernel calls are far slower than the
# stub (~30-35 min per mapping observed for L4's 4-layer stack, vs seconds
# for the stub), so these are `manual` -- not swept into `bazel test //...`
# -- and must be run explicitly, e.g.:
#   bazel test //src/tools/ipu-apps:test_full_layer_l4_query_major_real_softmax
_L4_REAL_SOFTMAX_ENV = {"USE_REAL_SOFTMAX": "1"}

# Split into one bazel target per attention mapping (query-major, key-major)
# -- combined into a single @pytest.mark.parametrize target, both mappings'
# ~25-40 min runs together exceeded even a 3600s "enormous" bazel timeout in
# the sandboxed environment. Each mapping now gets its own full budget.

py_pytest_test(
    name = "test_full_layer_l4_query_major",
    size = "enormous",
    tags = ["manual"],
    # A single "-k <expr>" bazel `args` entry containing spaces (e.g. "query_major
    # and not scaled") arrives at pytest word-split into separate argv entries
    # ("-k" "query_major" "and" "not" "scaled") -- some layer between bazel's
    # test-runner and the rules_python_pytest shim re-tokenizes multi-word args
    # entries on whitespace (reproduced with a plain "-k word1 word2 word3"
    # entry too, so it is not specific to and/not/scaled; single-WORD args
    # entries, including this file's "-k scale_is_visible"/"per_stage_error"
    # elsewhere, are unaffected). Deselecting the one other test that would
    # otherwise collide by substring match (--deselect takes one space-free
    # node ID per flag) sidesteps the bug instead of fighting bazel/rule
    # internals for it.
    args = [
        "-k",
        "query_major",
        "--deselect",
        "src/tools/ipu-apps/test/test_full_layer_l4.py::test_full_l4_layer_stack_agrees_query_major_scaled",
    ],
    srcs = _L4_FULL_LAYER_SRCS,
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_full_layer_l4_key_major",
    size = "enormous",
    tags = ["manual"],
    # See test_full_layer_l4_query_major's comment above for why this uses
    # -k + --deselect instead of a single multi-word "-k" expression.
    args = [
        "-k",
        "key_major",
        "--deselect",
        "src/tools/ipu-apps/test/test_full_layer_l4.py::test_full_l4_layer_stack_agrees_key_major_scaled",
    ],
    srcs = _L4_FULL_LAYER_SRCS,
    imports = ["src"],
    deps = [
        ":ipu_apps_lib",
        requirement("pytest"),
    ],
)

# test_full_l4_attention_scale_is_visible matches neither "query_major" nor
