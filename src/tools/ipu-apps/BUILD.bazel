# Split into one bazel target per attention mapping (query-major, key-major)
# -- combined into a single @pytest.mark.parametrize target, both mappings'
# ~25-40 min runs together exceeded even a 3600s "enormous" bazel timeout in
# the sandboxed environment. Each mapping now gets its own full budget.

py_pytest_test(
    name = "test_full_layer_l4_query_major",
    size = "enormous",
    # A single "-k <expr>" bazel `args` entry containing spaces (e.g. "query_major
    # and not scaled") arrives at pytest word-split into separate argv entries
    # ("-k" "query_major" "and" "not" "scaled") -- some layer between bazel's
    # test-runner and the rules_python_pytest shim re-tokenizes multi-word args
    # entries on whitespace (reproduced with a plain "-k word1 word2 word3"
    # entry too, so it is not specific to and/not/scaled; single-WORD args
    # entries, including this file's "-k scale_is_visible"/"per_stage_error"
    # elsewhere, are unaffected). Deselecting the one other test that would
    # otherwise collide by substring match (--deselect takes one space-free
    # node ID per flag) sidesteps the bug instead of fighting bazel/rule
    # internals for it.
    args = [
        "-k",
        "query_major",
        "--deselect",
        "src/tools/ipu-apps/test/test_full_layer_l4.py::test_full_l4_layer_stack_agrees_query_major_scaled",
    ],
    srcs = _L4_FULL_LAYER_SRCS,
