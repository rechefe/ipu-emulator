load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:runtime_deps.bzl", "runtime_deps_manifest")
load(":deps.bzl", "RUNTIME_DEPS")
load("//tools:lint.bzl", "ruff_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
])

# RUNTIME_DEPS as JSON, for //tools:deps_consistency_test.
runtime_deps_manifest(
    name = "runtime_deps",
    runtime_deps = RUNTIME_DEPS,
)

# The package's Python sources, for //tools:test_import_graph.
filegroup(
    name = "py_sources",
    srcs = glob(["src/**/*.py"]),
)

py_library(
    name = "ipu_as_lib",
    srcs = glob([
        "src/ipu_as/*.py",
    ]),
    data = glob([
        "src/ipu_as/**/*.lark",
        "src/ipu_as/templates/**/*.j2",
    ]),
    imports = ["src"],
    deps = [
        "//src/tools/ipu-gen:ipu_gen_lib",
        "//src/tools/ipu-isa:ipu_isa_lib",
    ] + [requirement(dep) for dep in RUNTIME_DEPS],
)

py_binary(
    name = "ipu-as",
    srcs = ["src/ipu_as/cli.py"],
    imports = ["src"],
    main = "src/ipu_as/cli.py",
    deps = [":ipu_as_lib"],
)

py_pytest_test(
    name = "test_assemble",
    srcs = ["test/test_assemble.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

# OPERAND_TYPE_MAP against the operand-type registry (E03-05).
py_pytest_test(
    name = "test_operand_type_map",
    srcs = ["test/test_operand_type_map.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

# Derived operand widths are right whatever is imported first (E03-08).
py_pytest_test(
    name = "test_import_order",
    srcs = ["test/test_import_order.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

# compound_inst.SLOT_TO_INST against the slot registry (E03-06).
py_pytest_test(
    name = "test_slot_to_inst",
    srcs = ["test/test_slot_to_inst.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_diagnostics",
    srcs = ["test/test_diagnostics.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

# The `check --json` contract with the VS Code extension: a snapshot of v1 over
# the extension's corpus and test_diagnostics' sources, and each version's schema.
py_pytest_test(
    name = "test_check_json",
    srcs = ["test/test_check_json.py"],
    data = [
        "test/golden/check_json_v1.json",
        "test/test_diagnostics.py",
        "//vscode-ipu-asm:check_json_contract",
        "//vscode-ipu-asm:corpus",
    ],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("jsonschema"),
        requirement("pytest"),
        requirement("referencing"),
    ],
)

py_pytest_test(
    name = "test_hover_data",
    srcs = ["test/test_hover_data.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

# The editor's completion data (isa.json operandTypes, lexical rules) against the
# assembler's own token constructors.
py_pytest_test(
    name = "test_isa_data",
    srcs = ["test/test_isa_data.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_gen_codegen",
    srcs = ["test/test_gen_codegen.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_sv_package_compiles",
    srcs = ["test/test_sv_package_compiles.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
        requirement("pyslang"),
    ],
)

# Decode snapshots (E02-02): instruction-word field names, the emulator's
# operand-to-field maps and the enum descriptors, pinned as JSON in
# test/baselines/. `bazel run :update_decode_snapshots` rewrites them.
py_library(
    name = "decode_snapshots",
    testonly = True,
    srcs = ["test/baselines/decode_snapshots.py"],
    imports = ["test/baselines"],
    deps = [
        ":ipu_as_lib",
        "//src/tools/ipu-emu-py:ipu_emu_lib",
    ],
)

py_pytest_test(
    name = "test_decode_snapshots",
    srcs = ["test/test_decode_snapshots.py"],
    data = glob(["test/baselines/*.json"]),
    deps = [":decode_snapshots", requirement("pytest")],
)

py_binary(
    name = "update_decode_snapshots",
    testonly = True,
    srcs = ["test/baselines/update_decode_snapshots.py"],
    main = "test/baselines/update_decode_snapshots.py",
    deps = [":decode_snapshots"],
)

# SV package golden (E02-03): the rendered ipu_instr_pkg.sv
# and every *_WIDTH localparam pinned by name. `bazel run :update_sv_golden`
# rewrites the golden file; the localparam table is edited by hand.
py_binary(
    name = "update_sv_golden",
    srcs = ["test/golden/update_sv_golden.py"],
    main = "test/golden/update_sv_golden.py",
    deps = [":ipu_as_lib"],
)

py_pytest_test(
    name = "test_sv_package_golden",
    srcs = [
        "test/golden/update_sv_golden.py",
        "test/test_sv_package_golden.py",
    ],
    data = ["test/golden/ipu_instr_pkg.sv"],
    imports = ["test/golden"],
    deps = [":ipu_as_lib", requirement("pytest")],
)

# Generated-artifact snapshots (E02-04): the docs pages, the TextMate grammar,
# isa.json and the union layout SVG, regenerated in-process and compared byte
# for byte. `bazel run :update_generated_artifacts` rewrites them.
py_library(
    name = "generated_artifacts",
    testonly = True,
    srcs = ["test/baselines/generated_artifacts.py"],
    imports = ["test/baselines"],
    deps = [
        ":ipu_as_lib",
        "//src/tools/ipu-gen:ipu_gen_lib",
        "//vscode-ipu-asm:gen_vscode_lib",
    ],
)

py_pytest_test(
    name = "test_generated_artifacts",
    srcs = ["test/test_generated_artifacts.py"],
    data = glob(["test/baselines/generated/**"]),
    deps = [":generated_artifacts", requirement("pytest")],
)

py_binary(
    name = "update_generated_artifacts",
    testonly = True,
    srcs = ["test/baselines/update_generated_artifacts.py"],
    main = "test/baselines/update_generated_artifacts.py",
    deps = [":generated_artifacts"],
)

# Ruff lint and format over this package's Python files (tools/lint.bzl).
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
)
