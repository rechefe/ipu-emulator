load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:runtime_deps.bzl", "runtime_deps_manifest")
load(":deps.bzl", "RUNTIME_DEPS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
])

# RUNTIME_DEPS as JSON, for //tools:deps_consistency_test.
runtime_deps_manifest(
    name = "runtime_deps",
    runtime_deps = RUNTIME_DEPS,
)

py_library(
    name = "ipu_as_lib",
    srcs = glob([
        "src/ipu_as/*.py",
    ]),
    data = glob([
        "src/ipu_as/**/*.lark",
        "src/ipu_as/templates/**/*.j2",
    ]),
    imports = ["src"],
    deps = [
        "//src/tools/ipu-common:ipu_common_lib",
    ] + [requirement(dep) for dep in RUNTIME_DEPS],
)

py_binary(
    name = "ipu-as",
    srcs = ["src/ipu_as/cli.py"],
    imports = ["src"],
    main = "src/ipu_as/cli.py",
    deps = [":ipu_as_lib"],
)

py_pytest_test(
    name = "test_assemble",
    srcs = ["test/test_assemble.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_diagnostics",
    srcs = ["test/test_diagnostics.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_hover_data",
    srcs = ["test/test_hover_data.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

# The editor's completion data (isa.json operandTypes, lexical rules) against the
# assembler's own token constructors.
py_pytest_test(
    name = "test_isa_data",
    srcs = ["test/test_isa_data.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_gen_codegen",
    srcs = ["test/test_gen_codegen.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_sv_package_compiles",
    srcs = ["test/test_sv_package_compiles.py"],
    imports = ["src"],
    deps = [
        ":ipu_as_lib",
        requirement("pytest"),
        requirement("pyslang"),
    ],
)
