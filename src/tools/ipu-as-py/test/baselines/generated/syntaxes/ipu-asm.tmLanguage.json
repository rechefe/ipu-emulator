      "name": "variable.language.register.ipu-asm"
    },
    "semi": {
      "match": ";",
      "name": "punctuation.separator.slot.ipu-asm"
    },
    "semi2": {
      "match": ";;",
      "name": "punctuation.terminator.bundle.ipu-asm"
    },
    "token": {
