load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:runtime_deps.bzl", "runtime_deps_manifest")
load(":deps.bzl", "RUNTIME_DEPS")
load("//tools:lint.bzl", "ruff_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
])

# RUNTIME_DEPS as JSON, for //tools:deps_consistency_test.
runtime_deps_manifest(
    name = "runtime_deps",
    runtime_deps = RUNTIME_DEPS,
)

# The package's Python sources, for //tools:test_import_graph.
filegroup(
    name = "py_sources",
    srcs = glob(["src/**/*.py"]),
)

# The interactive debugger (line CLI and curses TUI) over the emulator's one
# debug seam, run_with_debug(..., control=...). The dependency is one way:
# ipu_emu_lib does not depend on this library (Q62, tools/import_graph.toml).
py_library(
    name = "ipu_debug_lib",
    srcs = glob(["src/ipu_debug/*.py"]),
    imports = ["src"],
    deps = [
        "//src/tools/ipu-emu-py:ipu_emu_lib",
        "//src/tools/ipu-isa:ipu_isa_lib",
        # Temporary: the disassembly and pipeline views decode through
        # CompoundInst (E03-18 moves disassembly to ipu_isa and removes it).
        "//src/tools/ipu-as-py:ipu_as_lib",
    ] + [requirement(dep) for dep in RUNTIME_DEPS],
)

# pytest.ini (warning filters) reaches pytest through the runfiles tree, so it
# is data, not a test src.
py_pytest_test(
    name = "test_debug_cli",
    srcs = ["test/test_debug_cli.py"],
    data = ["pytest.ini"],
    imports = ["src"],
    deps = [
        ":ipu_debug_lib",
        "//src/tools/ipu-emu-py:emu_test_support",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_debug_tui",
    srcs = ["test/test_debug_tui.py"],
    data = ["pytest.ini"],
    imports = ["src"],
    deps = [
        ":ipu_debug_lib",
        "//src/tools/ipu-emu-py:emu_test_support",
        requirement("pytest"),
    ],
)

# DebugSession on real states: parse, resolve, read and disassemble.
py_pytest_test(
    name = "test_session",
    srcs = ["test/test_session.py"],
    data = ["pytest.ini"],
    imports = ["src"],
    deps = [
        ":ipu_debug_lib",
        "//src/tools/ipu-emu-py:emu_test_support",
        requirement("pytest"),
    ],
)

# No module imports a _-prefixed name from another ipu_debug module (Q66). It
# reads this package's sources and tests and the apps that launch the debugger.
py_pytest_test(
    name = "test_no_private_imports",
    srcs = ["test/test_no_private_imports.py"],
    data = [
        "pytest.ini",
        ":py_sources",
        "//src/tools/ipu-apps:py_sources",
    ] + glob(["test/*.py"]),
    deps = [requirement("pytest")],
)

# Ruff lint and format over this package's Python files (tools/lint.bzl).
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
)
