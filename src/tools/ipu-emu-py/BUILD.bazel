py_pytest_test(
    name = "test_prototyping_equivalence",
    srcs = ["test/test_prototyping_equivalence.py"],
    imports = ["src"],
    deps = [
        ":emu_test_support",
        ":ipu_emu_lib",
        ":timing_probes",
        requirement("pytest"),
    ],
