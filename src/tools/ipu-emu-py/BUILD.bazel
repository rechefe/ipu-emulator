load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:runtime_deps.bzl", "runtime_deps_manifest")
load(":deps.bzl", "RUNTIME_DEPS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
])

# RUNTIME_DEPS as JSON, for //tools:deps_consistency_test.
runtime_deps_manifest(
    name = "runtime_deps",
    runtime_deps = RUNTIME_DEPS,
)

# Carries the --define=ipu_proto flag into the package. `prototyping.py` imports
# this defensively, so a plain (non-Bazel) checkout still works with the fast
# paths off.
genrule(
    name = "build_flags",
    outs = ["src/ipu_emu/_build_flags.py"],
    cmd = select({
        "//:prototyping_on": "echo 'PROTOTYPING = True' > $@",
        "//conditions:default": "echo 'PROTOTYPING = False' > $@",
    }),
)

py_library(
    name = "ipu_emu_lib",
    srcs = glob(["src/ipu_emu/*.py"]) + [":build_flags"],
    imports = ["src"],
    deps = [
        "//src/tools/ipu-as-py:ipu_as_lib",
        "//src/tools/ipu-common:ipu_common_lib",
    ] + [requirement(dep) for dep in RUNTIME_DEPS],
)

# Shared by every emulator test: conftest.py (autouse fixtures), the
# assemble-load-run helpers and pytest.ini (warning filters). pytest finds
# conftest.py and pytest.ini through the runfiles tree, so they are not test srcs:
# rules_python_pytest passes every src to pytest as a file to collect.
py_library(
    name = "emu_test_support",
    testonly = True,
    srcs = [
        "test/conftest.py",
        "test/emu_support.py",
    ],
    data = ["pytest.ini"],
    imports = ["test"],
    deps = [
        ":ipu_emu_lib",
        "//src/tools/ipu-as-py:ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_xmem",
    srcs = ["test/test_xmem.py"],
    imports = ["src"],
    deps = [
        ":emu_test_support",
        ":ipu_emu_lib",
        requirement("pytest"),
    ],
)

