# Register-timing characterization (E02-05, E02-06): minimal probe programs in
# test/timing_probes.py, shared with test_prototyping_equivalence (E02-08).
# Each probe allocates a fresh IpuState (512 MiB XMEM, about 0.25 s), so the
# timing tests are sharded to stay under 5 s per shard; pytest_shard_plugin
# reads the shim's --shard-id/--num-shards.
py_library(
    name = "timing_probes",
    testonly = True,
    srcs = [
        "test/pytest_shard_plugin.py",
        "test/timing_probes.py",
    ],
    imports = ["test"],
    deps = [":ipu_emu_lib"],
)

py_pytest_test(
    name = "test_timing_lr_views",
    srcs = ["test/test_timing_lr_views.py"],
    args = ["-p", "pytest_shard_plugin"],
    shard_count = 6,
    imports = ["src"],
    deps = [
        ":timing_probes",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_timing_datapath_views",
    srcs = ["test/test_timing_datapath_views.py"],
    args = ["-p", "pytest_shard_plugin"],
    shard_count = 6,
    imports = ["src"],
    deps = [
        ":timing_probes",
        requirement("pytest"),
    ],
)

# The ISA's timing declarations against the two files above (E03-14). It
# reads the timing tests' source, so they are data, not imported.
py_pytest_test(
    name = "test_timing_declarations",
    srcs = ["test/test_timing_declarations.py"],
    data = [
        "test/test_timing_datapath_views.py",
        "test/test_timing_lr_views.py",
    ],
    imports = ["src"],
    deps = [
        ":ipu_emu_lib",
        requirement("pytest"),
    ],
)

# The Q71 emulator benchmarks (E04-02): IpuState() construction, matmul cycles/s
# (FP32 and INT8; prototyping too with --config=proto). A `bazel run` target, not a
# test: //tools/bench:bench_smoke_test keeps it from rotting. tools/bench/README.md.
# E04-02 names this label; the code lives in //tools/bench as its `emulator`
# module, so the nightly runner tracks it too.
py_binary(
    name = "bench_emulator",
    srcs = ["bench/bench_emulator.py"],
    main = "bench/bench_emulator.py",
    deps = ["//tools/bench:ipu_bench"],
)

# Ruff lint and format over this package's Python files (tools/lint.bzl).
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
)
