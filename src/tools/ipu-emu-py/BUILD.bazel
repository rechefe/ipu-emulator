load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:runtime_deps.bzl", "runtime_deps_manifest")
load(":deps.bzl", "RUNTIME_DEPS")
load("//tools:lint.bzl", "ruff_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
])

# RUNTIME_DEPS as JSON, for //tools:deps_consistency_test.
runtime_deps_manifest(
    name = "runtime_deps",
    runtime_deps = RUNTIME_DEPS,
)

# Carries the --define=ipu_proto flag into the package. `prototyping.py` imports
# this defensively, so a plain (non-Bazel) checkout still works with the fast
# paths off.
genrule(
    name = "build_flags",
    outs = ["src/ipu_emu/_build_flags.py"],
    cmd = select({
        "//:prototyping_on": "echo 'PROTOTYPING = True' > $@",
        "//conditions:default": "echo 'PROTOTYPING = False' > $@",
    }),
)

# The package's Python sources, for //tools:test_import_graph.
filegroup(
    name = "py_sources",
    srcs = glob(["src/**/*.py"]),
)

# The package's test sources, for //tools:test_import_graph's private-name check.
filegroup(
    name = "py_test_sources",
    srcs = glob(["test/**/*.py"], allow_empty = True),
)

py_library(
    name = "ipu_emu_lib",
    srcs = glob(["src/ipu_emu/*.py"]) + [":build_flags"],
    imports = ["src"],
    deps = [
        "//src/tools/ipu-as-py:ipu_as_lib",
        "//src/tools/ipu-isa:ipu_isa_lib",
    ] + [requirement(dep) for dep in RUNTIME_DEPS],
)

# Shared by every emulator test: the assemble-load-run helpers and pytest.ini
# (warning filters). pytest finds pytest.ini through the runfiles tree, so it is
# not a test src: rules_python_pytest passes every src to pytest as a file to
# collect.
py_library(
    name = "emu_test_support",
    testonly = True,
    srcs = ["test/emu_support.py"],
    data = ["pytest.ini"],
    imports = ["test"],
    deps = [
        ":ipu_emu_lib",
        "//src/tools/ipu-as-py:ipu_as_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_xmem",
    srcs = ["test/test_xmem.py"],
    imports = ["src"],
    deps = [
        ":emu_test_support",
        ":ipu_emu_lib",
        requirement("pytest"),
    ],
)

# FP8 codec checked against an independent Fraction reference and ml_dtypes.
py_pytest_test(
    name = "test_ipu_math",
    srcs = ["test/test_ipu_math.py"],
    imports = ["src"],
    deps = [
        ":emu_test_support",
        ":ipu_emu_lib",
        requirement("ml-dtypes"),
        requirement("pytest"),
    ],
)

# DType <-> ipu_isa ElementFormat correspondence (E03-13), for E04-17.
py_pytest_test(
    name = "test_element_formats",
    srcs = ["test/test_element_formats.py"],
    imports = ["src"],
    deps = [
        ":ipu_emu_lib",
        "//src/tools/ipu-isa:ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_regfile",
    srcs = ["test/test_regfile.py"],
    imports = ["src"],
    deps = [
        ":emu_test_support",
        ":ipu_emu_lib",
        requirement("pytest"),
    ],
)

# test_regfile again with assert statements compiled out of the emulator (python
# -O; pytest still rewrites the test's own asserts): the register file's checks
# must hold without asserts.
py_pytest_test(
    name = "test_regfile_optimized",
    srcs = ["test/test_regfile.py"],
    env = {"PYTHONOPTIMIZE": "1"},
    imports = ["src"],
    deps = [
        ":emu_test_support",
        ":ipu_emu_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_errors",
    size = "small",
    srcs = ["test/test_errors.py"],
    imports = ["src"],
    deps = [
        ":emu_test_support",
        ":ipu_emu_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_execute",
    srcs = ["test/test_execute.py"],
    imports = ["src"],
    deps = [
        ":emu_test_support",
        ":ipu_emu_lib",
        requirement("pytest"),
    ],
)

# The Cycle module (E04-07): step = evaluate_break + retire, no side effects
