+void BitArray::set_value_bytes(const unsigned char *bytes, unsigned byte_count)
+{
+    reset();
+    const size_type bits = size();
+    for (size_type i = 0; i < bits; ++i)
+    {
+        const unsigned byte = (unsigned)(i / 8);
+        if (byte >= byte_count)
+            break;
+        if ((bytes[byte] >> (i % 8)) & 1)
+            set(i);
+    }
+}
