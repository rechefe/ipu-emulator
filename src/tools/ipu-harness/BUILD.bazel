    tags = ["nightly"],
    deps = [
        ":ipu_harness_lib",
        "//kernels:all_kernels",
        "//src/tools/ipu-emu-py:ipu_emu_lib",
        "//src/tools/ipu-kernels:ipu_kernels_all",
        "//tools:pytest_shard_plugin",
        requirement("pytest"),
        requirement("torch"),
    ],
)

