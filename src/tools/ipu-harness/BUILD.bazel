        "src/ipu_harness/kernel_cases.py",
        "src/ipu_harness/kernel_fixtures.py",
        "src/ipu_harness/kernel_test.py",
    ],
    imports = ["src"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# mypy over the ipu_kernel() entry and its pytest plugin (tools/typecheck.bzl).
