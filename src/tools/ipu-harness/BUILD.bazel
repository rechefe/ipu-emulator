        requirement("numpy"),
        requirement("pytest"),
    ],
)

# Golden comparison and tolerance tiers (E06-10).
py_pytest_test(
    name = "test_compare",
    srcs = ["test/test_compare.py"],
    deps = [
        ":ipu_harness_lib",
        requirement("numpy"),
        requirement("pytest"),
    ],
)

# kernel.toml: the schema, the loader and its errors (E06-02).
py_pytest_test(
    name = "test_manifest",
    srcs = ["test/test_manifest.py"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# Strict from day one (E06-01, Q65).
mypy_test(
    name = "mypy",
    lib = ":ipu_harness_lib",
    strict = True,
)

# Ruff lint and format over this package's Python files (tools/lint.bzl).
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
)

# The epic's scale kernel, written to a temporary folder for the runner's tests.
py_library(
    name = "scale_kernel",
    testonly = True,
    srcs = ["test/scale_kernel.py"],
    imports = ["test"],
    deps = [
        ":ipu_harness_lib",
        requirement("numpy"),
    ],
)

# The runner end to end (E06-11), with torch for the scale kernel's reference.
py_pytest_test(
    name = "test_runner",
    srcs = ["test/test_runner.py"],
    deps = [
        ":ipu_harness_lib",
        ":scale_kernel",
        requirement("jsonschema"),
        requirement("numpy"),
        requirement("pytest"),
        requirement("torch"),
    ],
)

# Benchmarks from [benchmark] (E06-11), with torch for the scale kernel's reference.
py_pytest_test(
