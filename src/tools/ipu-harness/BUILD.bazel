load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:lint.bzl", "ruff_test")
load("//tools:typecheck.bzl", "mypy_test")

package(default_visibility = ["//visibility:public"])

# The package's Python sources, for //tools:test_import_graph.
filegroup(
    name = "py_sources",
    srcs = glob(["src/**/*.py"]),
)

# The package's test sources, for //tools:test_import_graph's private-name check.
filegroup(
    name = "py_test_sources",
    srcs = glob(["test/**/*.py"], allow_empty = True),
)

# The kernel framework (E06). ipu_as for its session API only, ipu_emu for its
# reference-model API only (checked in review); tools/import_graph.toml holds
# the package-level import rules.
py_library(
    name = "ipu_harness_lib",
    srcs = glob(
        ["src/ipu_harness/**/*.py"],
        exclude = [
            "src/ipu_harness/kernel_cases.py",
            "src/ipu_harness/kernel_fixtures.py",
            "src/ipu_harness/kernel_test.py",
        ],
    ),
    imports = ["src"],
    deps = [
        "//src/tools/ipu-as-py:ipu_as_lib",
        "//src/tools/ipu-debug:ipu_debug_lib",  # imported only for --debug
        "//src/tools/ipu-emu-py:ipu_emu_lib",
        "//src/tools/ipu-isa:ipu_isa_lib",
        requirement("numpy"),
        requirement("tomli"),  # tomllib before Python 3.11
    ],
)

# //kernels:query (E06-16). With ipu_kernels for the families' layer adapters.
# Each kernel's files reach its runfiles once E06-13's ipu_kernel() exports
# them; until then the tree it routes over is empty.
py_binary(
    name = "query",
    srcs = ["src/ipu_harness/query.py"],
    data = ["//kernels:tree"],
    main = "src/ipu_harness/query.py",
    deps = [
        ":ipu_harness_lib",
        "//src/tools/ipu-kernels:ipu_kernels_all",
    ],
)

# plan_case, the one parameter-validation seam (E06-03).
py_pytest_test(
    name = "test_params",
    srcs = ["test/test_params.py"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# Region placement (E06-04). ipu_apps only for the projections layouts that
# placement must reproduce (guards E07-02).
py_pytest_test(
    name = "test_placement",
    srcs = ["test/test_placement.py"],
    deps = [
        ":ipu_harness_lib",
        "//src/tools/ipu-apps:ipu_apps_lib",
        requirement("pytest"),
    ],
)

# Pack transforms on inputs and outputs, and a region's starting bytes (E06-05).
py_pytest_test(
    name = "test_packing",
    srcs = ["test/test_packing.py"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# A family's registry.toml: entries over a template, routing, registry.bzl (E06-17).
py_pytest_test(
    name = "test_family",
    srcs = ["test/test_family.py"],
    deps = [
        ":ipu_harness_lib",
        ":kernel_test_lib",
        requirement("pytest"),
    ],
)

# Conditional tensors and bindings (when).
py_pytest_test(
    name = "test_conditions",
    srcs = ["test/test_conditions.py"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# Cases, sweeps, seeded generators and user data (E06-08).
py_pytest_test(
    name = "test_cases",
    srcs = ["test/test_cases.py"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# Routing as a value: Registry, resolve, layer adapters (E06-16).
py_pytest_test(
    name = "test_registry",
    srcs = ["test/test_registry.py"],
    data = ["//kernels:tree"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# Registers from [abi] (E06-06). ipu_apps only for the projections' CRs it
# reproduces (guards E07-02, which deletes that harness); ipu_kernels for the
# shared pack transforms the projections declare.
py_pytest_test(
    name = "test_abi",
    srcs = ["test/test_abi.py"],
    deps = [
        ":ipu_harness_lib",
        "//src/tools/ipu-apps:ipu_apps_lib",
        "//src/tools/ipu-kernels:ipu_kernels_all",
        requirement("numpy"),
        requirement("pytest"),
    ],
)

# Assembly with the case as template values (E06-07). The kernel library's
# sources are data for the no-jinja2 check.
py_pytest_test(
    name = "test_assembly",
    srcs = ["test/test_assembly.py"],
    data = ["//src/tools/ipu-kernels:py_sources"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# Reference loading (E06-09). Without torch here, so the library's tests prove it
# needs none: evaluate's test skips, and runs with real torch in
