py_pytest_test(
    name = "test_kernel_test",
    srcs = ["test/test_kernel_test.py"],
    data = [
        "//kernels/elementwise/scale:scale_files",
        "//kernels/elementwise:files",
        "//kernels/elementwise/scale:assemble_scale",
        "//src/tools/ipu-harness/test/scales:assemble_scale_r2",
        "//src/tools/ipu-harness/test/scales:files",
        "//src/tools/ipu-harness/test/scales/scale_rows:scale_rows_files",
        "@rules_python_pytest//python_pytest:pytest_shim.py",
    ],
    env = {"PYTEST_SHIM": "$(rootpath @rules_python_pytest//python_pytest:pytest_shim.py)"},
    deps = [
        ":ipu_harness_lib",
        ":kernel_test_lib",
        requirement("pytest"),
        requirement("torch"),
