# The runner without torch: expected files need no reference (E06-11).
py_pytest_test(
    name = "test_runner_no_torch",
    srcs = ["test/test_runner_no_torch.py"],
    deps = [
        ":ipu_harness_lib",
        ":scale_kernel",
        requirement("pytest"),
    ],
