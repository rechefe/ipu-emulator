# Runs a kernel's case (E06-11). E06-13's ipu_kernel() wraps it per kernel; meanwhile:
#   bazel run //src/tools/ipu-harness:run_kernel -- path/to/kernel --case NAME --format all
py_binary(
    name = "run_kernel",
    srcs = ["src/ipu_harness/cli.py"],
    main = "src/ipu_harness/cli.py",
    deps = [":ipu_harness_lib"],
)

# Debugging and alias profiling as run options (E06-12).
py_pytest_test(
    name = "test_debug",
    srcs = ["test/test_debug.py"],
    data = [
        ":py_sources",
        "//src/tools/ipu-kernels:py_sources",
    ],
    deps = [
        ":ipu_harness_lib",
        ":scale_kernel",
        requirement("numpy"),
        requirement("pytest"),
    ],
)

# What every :assemble_<name> runs (kernels/defs.bzl): the default case's .bin.
py_binary(
    name = "kernel_bin",
    srcs = ["src/ipu_harness/kernel_bin.py"],
    main = "src/ipu_harness/kernel_bin.py",
    deps = [":ipu_harness_lib"],
)

# What every ipu_kernel() target runs (E06-13, kernels/defs.bzl): the entry, the
# generated case x format tests and their fixtures (pytest, so not in the library).
exports_files([
    "src/ipu_harness/kernel_test.py",
    "src/ipu_harness/manifest_json.py",
    "src/ipu_harness/registry_bzl.py",
])

py_library(
    name = "kernel_test_lib",
    srcs = [
        "src/ipu_harness/kernel_cases.py",
        "src/ipu_harness/kernel_fixtures.py",
        "src/ipu_harness/kernel_test.py",
    ],
    imports = ["src"],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)

# mypy over the ipu_kernel() entry and its pytest plugin (tools/typecheck.bzl).
mypy_test(
    name = "mypy_kernel_test",
    lib = ":kernel_test_lib",
)

# The ipu_kernel() entry, through the real rules_python_pytest shim, on a copy of
# //kernels/elementwise/scale: generated tests, the folder's own tests, tiers,
# sharding, the test filter, bazel run; and an entry of the fixture family
# test/scales (E06-17).
py_pytest_test(
    name = "test_kernel_test",
    srcs = ["test/test_kernel_test.py"],
    data = [
        "//kernels/elementwise/scale:scale_files",
        "//kernels/elementwise:files",
        "//kernels/elementwise/scale:assemble_scale",
        "//src/tools/ipu-harness/test/scales:assemble_scale_r2",
        "//src/tools/ipu-harness/test/scales:files",
        "//src/tools/ipu-harness/test/scales/scale_rows:scale_rows_files",
        "@rules_python_pytest//python_pytest:pytest_shim.py",
    ],
    env = {"PYTEST_SHIM": "$(rootpath @rules_python_pytest//python_pytest:pytest_shim.py)"},
    deps = [
        ":ipu_harness_lib",
        ":kernel_test_lib",
        requirement("pytest"),
        requirement("torch"),
    ],
)

# The kernel list in kernels/BUILD.bazel, //kernels:tree and //kernels:manifest.
py_pytest_test(
    name = "test_kernel_tree",
    srcs = ["test/test_kernel_tree.py"],
    # It reads the checkout's kernels/ to find a folder missing from KERNELS; that
    # folder is no input of the test, so the result must not be cached.
    tags = ["external"],
    data = [
        "//kernels:BUILD.bazel",
        "//kernels:kernel_targets",
        "//kernels:tree",
    ],
    deps = [
        ":ipu_harness_lib",
        requirement("pytest"),
    ],
)
