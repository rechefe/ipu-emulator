# A fixture family for ipu_kernel_family()'s registry entries (E06-17): the
# entries of registry.toml over the template folder scale_rows/. Outside
# kernels/, so routing never sees it; it has no ipu_kernels package of its own.

load("//kernels:defs.bzl", "ipu_kernel_family")
load(":registry.bzl", "ENTRIES")

ipu_kernel_family(
    entries = ENTRIES,
    kernels_lib = "//src/tools/ipu-kernels:ipu_kernels_lib",
)
