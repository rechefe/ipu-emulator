# mypy over ipu_isa_lib with the locked mypy and //:mypy.ini (tools/typecheck.bzl).
mypy_test(
    name = "mypy",
    lib = ":ipu_isa_lib",
    strict = True,
)

# Ruff lint and format over this package's Python files (tools/lint.bzl).
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
)
