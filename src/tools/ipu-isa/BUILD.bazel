load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:runtime_deps.bzl", "runtime_deps_manifest")
load(":deps.bzl", "RUNTIME_DEPS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
])

# RUNTIME_DEPS as JSON, for //tools:deps_consistency_test.
runtime_deps_manifest(
    name = "runtime_deps",
    runtime_deps = RUNTIME_DEPS,
)

py_library(
    name = "ipu_isa_lib",
    srcs = glob([
        "src/ipu_isa/*.py",
    ]),
    imports = ["src"],
    deps = [requirement(dep) for dep in RUNTIME_DEPS],
)

py_binary(
    name = "gen_union_layout_svg",
    srcs = ["src/ipu_isa/gen_union_layout_svg.py"],
    imports = ["src"],
    main = "src/ipu_isa/gen_union_layout_svg.py",
    deps = [":ipu_isa_lib"],
)

py_pytest_test(
    name = "test_isa_alias_spec",
    srcs = ["test/test_isa_alias_spec.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_union_layout",
    srcs = ["test/test_union_layout.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_union_layout_svg",
    srcs = ["test/test_union_layout_svg.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)
