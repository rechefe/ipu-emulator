load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:runtime_deps.bzl", "runtime_deps_manifest")
load(":deps.bzl", "RUNTIME_DEPS")
load("//tools:lint.bzl", "ruff_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
])

# RUNTIME_DEPS as JSON, for //tools:deps_consistency_test.
runtime_deps_manifest(
    name = "runtime_deps",
    runtime_deps = RUNTIME_DEPS,
)

# The package's Python sources, for //tools:test_import_graph.
filegroup(
    name = "py_sources",
    srcs = glob(["src/**/*.py"]),
)

py_library(
    name = "ipu_isa_lib",
    srcs = glob([
        "src/ipu_isa/*.py",
    ]),
    imports = ["src"],
    deps = [requirement(dep) for dep in RUNTIME_DEPS],
)

py_pytest_test(
    name = "test_union_layout",
    srcs = ["test/test_union_layout.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)


# ipu_isa imports nothing from the other IPU packages (E03-02). Depends on
# ipu_isa_lib alone, so Bazel enforces the rule as well.
py_pytest_test(
    name = "test_purity",
    srcs = ["test/test_purity.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_schema",
    srcs = ["test/test_schema.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_syntax",
    srcs = ["test/test_syntax.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_operand_types",
    srcs = ["test/test_operand_types.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_slots",
    srcs = ["test/test_slots.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_tags",
    srcs = ["test/test_tags.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

py_pytest_test(
    name = "test_layout",
    srcs = ["test/test_layout.py"],
    imports = ["src"],
    deps = [
        ":ipu_isa_lib",
        requirement("pytest"),
    ],
)

# Ruff lint and format over this package's Python files (tools/lint.bzl).
# Manual until E01-10 makes the repository pass; run with `bazel test //tools:lint`.
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
    tags = ["manual"],
)
