load("@ipu_as_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:lint.bzl", "ruff_test")
load("//tools:runtime_deps.bzl", "runtime_deps_manifest")
load(":deps.bzl", "RUNTIME_DEPS")
load("//tools:typecheck.bzl", "mypy_test")

package(default_visibility = ["//visibility:public"])

exports_files(["pyproject.toml"])

# RUNTIME_DEPS as JSON, for //tools:deps_consistency_test.
runtime_deps_manifest(
    name = "runtime_deps",
    runtime_deps = RUNTIME_DEPS,
)

# The package's Python sources, for //tools:test_import_graph.
filegroup(
    name = "py_sources",
    srcs = glob(["src/**/*.py"]),
)

# The package's test sources, for //tools:test_import_graph's private-name check.
filegroup(
    name = "py_test_sources",
    srcs = glob(["test/**/*.py"], allow_empty = True),
)

# Kernel-side Python shared across kernels (E06): references, pack transforms,
# family code. tools/import_graph.toml holds the import rules.
py_library(
    name = "ipu_kernels_lib",
    srcs = glob(["src/ipu_kernels/**/*.py"]),
    imports = ["src"],
    deps = [
        "//src/tools/ipu-harness:ipu_harness_lib",
        "//src/tools/ipu-isa:ipu_isa_lib",
    ] + [requirement(name) for name in RUNTIME_DEPS],
)

mypy_test(
    name = "mypy",
    lib = ":ipu_kernels_lib",
)

# Ruff lint and format over this package's Python files (tools/lint.bzl).
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
)

# Packing with the shared transforms (E06-05). ipu_apps only for the loaders
# the transforms are extracted from: E07-02 freezes these byte goldens before it
# deletes the loaders, and drops the dependency.
py_pytest_test(
    name = "test_pack",
    srcs = ["test/test_pack.py"],
    deps = [
        ":ipu_kernels_lib",
        "//src/tools/ipu-apps:ipu_apps_lib",
        "//src/tools/ipu-harness:ipu_harness_lib",
        requirement("numpy"),
        requirement("pytest"),
    ],
)

# The shared references (E06-09). torch is test-only (Q74b): only targets that
# run a reference depend on it, never ipu_kernels_lib.
py_pytest_test(
    name = "test_reference_ops",
    srcs = ["test/test_reference_ops.py"],
    deps = [
        ":ipu_kernels_lib",
        "//src/tools/ipu-harness:ipu_harness_lib",
        requirement("numpy"),
        requirement("pytest"),
        requirement("torch"),
    ],
)
