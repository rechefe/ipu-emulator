# Upper-case the mnemonics and register names of assembly sources (E07-01).
# :test_upper_mnemonics runs --check over kernels/, so every kernel program
# keeps CLAUDE.md's upper case; run this on one that fails.
#
#   bazel run //tools:upper_mnemonics -- [--check] FILE...
py_binary(
    name = "upper_mnemonics",
    srcs = ["upper_mnemonics.py"],
    deps = [
        "//src/ipu-as:ipu_as_lib",
        "//src/ipu-isa:ipu_isa_lib",
    ],
)

# Rewrites every program of the E02 asm corpus (a dry run in a temporary tree)
# and holds each to its recorded binary digest; every kernels/ source is
# already upper case (--check).
py_pytest_test(
    name = "test_upper_mnemonics",
    srcs = [
        "test_upper_mnemonics.py",
        "upper_mnemonics.py",
    ],
    data = [
        "//kernels:tree",
        "//src/ipu-as:asm_corpus_files",
    ],
    imports = ["."],
    deps = [
        "//src/ipu-as:asm_corpus",
        "//src/ipu-as:ipu_as_lib",
        "//src/ipu-isa:ipu_isa_lib",
        requirement("pytest"),
    ],
)

# The locked ruff (requirements_lock.txt), run in the workspace root:
#
#   bazel run //tools:ruff -- check --fix
#   bazel run //tools:ruff -- format
#   bazel run //tools:ruff -- --version
py_binary(
    name = "ruff",
    srcs = ["ruff_runner.py"],
    data = [data_requirement("ruff")],
    main = "ruff_runner.py",
    deps = [requirement("ruff")],
)

# Every ruff_test in the repository (tools/lint.bzl), one per package:
# `bazel test //tools:lint`. The ruff tests also run in the default tier
# (`bazel test //...`) and carry the `lint` tag
# (`bazel test --test_tag_filters=lint //...`). Listed explicitly;
# tools/check_lint_coverage.sh checks that this list matches the ruff_test
# targets.
test_suite(
    name = "lint",
    tests = [
        "//:ruff",
        "//docs:ruff",
        "//docs/inspector:ruff",
        "//kernels:lint",
        "//src/ipu-as:ruff",
        "//src/ipu-debug:ruff",
        "//src/ipu-emu:ruff",
        "//src/ipu-gen:ruff",
        "//fpga/alveo-u55c:ruff",
        "//src/ipu-harness:ruff",
        "//src/ipu-harness/test/scales:ruff",
        "//src/ipu-host:ruff",
        "//src/ipu-harness/test/scales/scale_rows:ruff",
        "//src/ipu-isa:ruff",
        "//src/ipu-kernels:ruff",
        "//tools:ruff_lint",
        "//tools/bench:ruff",
        "//vscode-ipu-asm:ruff",
    ],
)

# Ruff over this package's Python files (tools/lint.bzl). Named ruff_lint, not
# ruff, because //tools:ruff is the runnable ruff above.
ruff_test(
    name = "ruff_lint",
    srcs = glob(["**/*.py"]),
)

# What every baseline updater and baseline test shares: the workspace an
# update_* target writes into, and the snapshot diff a test fails with.
py_library(
    name = "baseline_support",
    testonly = True,
    srcs = ["baseline_support.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [requirement("pytest")],
)

# Bazel test sharding for pytest (`-p pytest_shard_plugin`): the timing tests
