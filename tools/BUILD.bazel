load("@ipu_deps//:requirements.bzl", "data_requirement", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_python_pytest//python_pytest:defs.bzl", "py_pytest_test")
load("//tools:lint.bzl", "ruff_test")

exports_files([
    # Read by //docs:architecture_page (the Architecture page's package table).
    "import_graph.toml",
    "mypy_runner.py",
    "requirements-tools.in",
    "ruff_runner.py",
])

# Refresh //:requirements_lock.txt from the seven pyproject.toml files and
# tools/requirements-tools.in. Runs uv from the lock itself, so no host tool is
# needed. Extra arguments go to `uv pip compile`:
#
#   bazel run //tools:update_requirements_lock
#   bazel run //tools:update_requirements_lock -- --upgrade-package numpy
#   bazel run //tools:update_requirements_lock -- --upgrade
py_binary(
    name = "update_requirements_lock",
    srcs = ["update_requirements_lock.py"],
    deps = [requirement("uv")],
)

# Every requirement in the pyproject.toml files and requirements-tools.in is
# pinned in the lock, and each package's deps.bzl RUNTIME_DEPS (its py_library's
# third-party deps) equals its [project].dependencies minus ipu-* packages.
py_pytest_test(
    name = "test_deps_consistency",
    size = "small",
    srcs = ["test_deps_consistency.py"],
    data = [
        "requirements-tools.in",
        "//:requirements_lock.txt",
        "//src/ipu-as:pyproject.toml",
        "//src/ipu-as:runtime_deps",
        "//src/ipu-debug:pyproject.toml",
        "//src/ipu-debug:runtime_deps",
        "//src/ipu-gen:pyproject.toml",
        "//src/ipu-gen:runtime_deps",
        "//src/ipu-harness:pyproject.toml",
        "//src/ipu-harness:runtime_deps",
        "//src/ipu-host:pyproject.toml",
        "//src/ipu-host:runtime_deps",
        "//src/ipu-kernels:pyproject.toml",
        "//src/ipu-kernels:runtime_deps",
        "//src/ipu-isa:pyproject.toml",
        "//src/ipu-isa:runtime_deps",
        "//src/ipu-emu:pyproject.toml",
        "//src/ipu-emu:runtime_deps",
    ],
    deps = [
        requirement("pytest"),
        requirement("tomli"),
    ],
)

# Glossary adoption check (glossary_check.py): the hand-written docs add no use
# of a term GLOSSARY.md lists under _Avoid_. Counts per file and term are in
# glossary_baseline.json and may only go down. Default tier.
py_library(
    name = "glossary_check",
    srcs = ["glossary_check.py"],
)

py_pytest_test(
    name = "test_glossary_adoption",
    size = "small",
    srcs = ["test_glossary_adoption.py"],
    data = [
        "glossary_baseline.json",
        "//:CLAUDE.md",
        "//:GLOSSARY.md",
        "//:README.md",
        "//:SKILL.md",
        "//docs:doc_sources",
    ],
    deps = [
        ":glossary_check",
        requirement("pytest"),
    ],
)

# Rewrite glossary_baseline.json from the working tree, after removing uses of
# avoided terms: `bazel run //tools:glossary_baseline`.
py_binary(
    name = "glossary_baseline",
    srcs = ["glossary_baseline.py"],
    deps = [":glossary_check"],
)

