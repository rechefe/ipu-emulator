# VS Code extension for IPU assembly.
#
# The grammar is GENERATED from the assembler's own parser (see
# //src/tools/ipu-gen: ipu_gen/vscode_data.py), so it cannot drift from the
# language the assembler accepts.
#
# Node/npm is deliberately NOT wired into Bazel. Bazel's involvement is the
# Python targets below (gen_vscode, dump_parser_tokens, check_rewrites,
# check_verdicts); the JS tests and the .vsix build run in
# .github/workflows/vscode-extension.yml. Please do not add a JS ruleset here.

load("@rules_python//python:defs.bzl", "py_binary")
load("//tools:lint.bzl", "ruff_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "package.json",
    ".vscodeignore",
])

# The `ipu-as check --json` contract (schema/check-json.md), and the corpus its
# snapshot runs over: //src/tools/ipu-as-py:test_check_json.
filegroup(
    name = "check_json_contract",
    srcs = glob(["schema/*"]),
)

filegroup(
    name = "corpus",
    srcs = glob(["test/corpus/**/*.asm"]),
)

# The assembly fixtures, for the assembled-binary baseline in
# //src/tools/ipu-as-py:test_asm_digests. Not the negative corpus: texts the
# editor and the assembler judge (check_verdicts), most of which do not assemble
# (asm_corpus.NOT_PROGRAMS leaves it out of a checkout's corpus too).
filegroup(
    name = "asm_fixtures",
    srcs = glob(
        ["test/**/*.asm"],
        exclude = ["test/corpus/negative/**"],
    ),
)

# Writes syntaxes/ipu-asm.tmLanguage.json, language-configuration.json and data/isa.json
# (`ipu-gen vscode-data`).
#   bazel run //vscode-ipu-asm:gen_vscode          -> into the source tree
#   bazel build //vscode-ipu-asm:generate_grammar  -> into bazel-out
alias(
    name = "gen_vscode",
    actual = "//src/tools/ipu-gen:vscode_data",
)

# Ground truth for the agreement test: the parser's own tokenization of the
# corpus, including each token's structural role.
alias(
    name = "dump_parser_tokens",
    actual = "//src/tools/ipu-as-py:dump_parser_tokens",
)

# Judges test/verdicts.js: the editor's verdict on each text against the
# assembler's (ipu_as.diagnostics.check, what `ipu-as check --json` prints).
#   bazel run //vscode-ipu-asm:check_verdicts -- <verdicts.json>
py_binary(
    name = "check_verdicts",
    srcs = ["check_verdicts.py"],
    data = ["test/corpus/negative/allowed-gaps.json"],
    main = "check_verdicts.py",
    python_version = "PY3",
    deps = ["//src/tools/ipu-as-py:ipu_as_lib"],
)

# Judges test/rewrites.js: every rename and format the editor could apply to
# the corpus must assemble to the same binary as the original.
#   bazel run //vscode-ipu-asm:check_rewrites -- <rewrites.json>
py_binary(
    name = "check_rewrites",
    srcs = ["check_rewrites.py"],
    main = "check_rewrites.py",
    python_version = "PY3",
    deps = ["//src/tools/ipu-as-py:ipu_as_lib"],
)

genrule(
    name = "generate_grammar",
    outs = [
        "generated/syntaxes/ipu-asm.tmLanguage.json",
        "generated/language-configuration.json",
        # Hover data. Undeclared, this rule produced an extension whose hover
        # was silently missing rather than a build error.
        "generated/data/isa.json",
    ],
    cmd = "$(location //src/tools/ipu-gen:ipu-gen) vscode-data $(RULEDIR)/generated",
    tools = ["//src/tools/ipu-gen:ipu-gen"],
)

# The corpus is passed on the command line rather than declared as srcs:
#
#   bazel run //vscode-ipu-asm:dump_parser_tokens -- <out.json> <file.asm>...
#
# `bazel run` needs no declared inputs, which keeps the app package free of a
# filegroup that exists only for this tool. See the workflow for the invocation.

# Ruff lint and format over this package's Python files (tools/lint.bzl).
ruff_test(
    name = "ruff",
    srcs = glob(["**/*.py"]),
)
