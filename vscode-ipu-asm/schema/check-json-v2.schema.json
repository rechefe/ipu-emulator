{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "check-json-v2.schema.json",
  "title": "ipu-as check --json --json-version 2",
  "description": "Version 2 wraps version 1's diagnostics in an object that names its version, so later versions can add fields beside them. `--tokens`, `--words` and `--jinja` each add the key of the same name; without the option the key is absent. Positions are 0-based. See check-json.md.",
  "type": "object",
  "required": ["schemaVersion", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "diagnostics": { "$ref": "check-json-v1.schema.json" },
    "tokens": {
      "description": "Semantic tokens of the source (--tokens), sorted by line and column; none overlap and none spans a line end. An assembly token produced by a {{ }} expression is not listed: the Jinja region over it is.",
      "type": "array",
      "items": { "$ref": "#/$defs/token" }
    },
    "words": {
      "description": "Each word's slot fit (--words), each placed once however often loops render it. Absent words: the source does not render or parse (see the diagnostics).",
      "type": "array",
      "items": { "$ref": "#/$defs/word" }
    },
    "jinja": {
      "description": "Every Jinja tag of the source (--jinja), in order, as Jinja's own lexer reads them.",
      "type": "array",
      "items": { "$ref": "#/$defs/jinjaRegion" }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "range": {
      "type": "object",
      "required": ["line", "column", "end_line", "end_column"],
      "additionalProperties": false,
      "properties": {
        "line": { "$ref": "#/$defs/count" },
        "column": { "$ref": "#/$defs/count" },
        "end_line": { "$ref": "#/$defs/count" },
        "end_column": { "$ref": "#/$defs/count" }
      }
    },
    "names": { "type": "array", "items": { "type": "string" } },
    "token": {
      "type": "object",
      "required": ["line", "col", "length", "type", "role"],
      "additionalProperties": false,
      "properties": {
        "line": { "$ref": "#/$defs/count" },
        "col": { "$ref": "#/$defs/count" },
        "length": { "type": "integer", "minimum": 1 },
        "type": {
          "description": "The grammar's terminal for an assembly token; the region kind for a Jinja one.",
          "enum": ["TOKEN", "COMMENT_HASH", "COMMENT_LINE", "comment", "block", "variable"]
        },
        "role": {
          "enum": ["mnemonic", "register", "enum", "number", "label-def", "label-ref", "comment", "jinja"]
        }
      }
    },
    "word": {
      "type": "object",
      "required": ["range", "mnemonics", "slots", "fits", "error"],
      "additionalProperties": false,
      "properties": {
        "range": { "$ref": "#/$defs/range" },
        "mnemonics": { "$ref": "#/$defs/names" },
        "slots": {
          "description": "Slot name -> instructions in it; for a word that does not fit, the slots its instructions ask for.",
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "fits": { "type": "boolean" },
        "error": { "type": ["string", "null"] }
      }
    },
    "jinjaRegion": {
      "type": "object",
      "required": ["kind", "range", "defines", "uses", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["comment", "block", "variable"] },
        "range": { "$ref": "#/$defs/range" },
        "defines": { "$ref": "#/$defs/names" },
        "uses": { "$ref": "#/$defs/names" },
        "start": { "$ref": "#/$defs/count" },
        "end": { "$ref": "#/$defs/count" }
      }
    }
  }
}
